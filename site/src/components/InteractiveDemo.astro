    scrollbar-width: none;
    white-space: nowrap;
  }

  .demo-statusbar > * { flex: none; border-right: 1px solid var(--tui-surface-1); padding: .25rem .6rem; }
  .demo-statusbar button { border-block: 0; border-left: 0; background: transparent; color: var(--tui-text); font: inherit; cursor: pointer; }
  .demo-statusbar button:hover { background: var(--tui-surface-0); }
  .demo-statusbar kbd { color: var(--tui-yellow); }
  .demo-engine { display: inline-flex; align-items: center; gap: .35rem; }
  .demo-engine b { color: var(--tui-green); font-weight: 400; }
  .demo-engine [data-demo-engine-label] { display: none; }
  .demo-engine i { width: .42rem; height: .42rem; border-radius: 50%; background: var(--tui-overlay); }
