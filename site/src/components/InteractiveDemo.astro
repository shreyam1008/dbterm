<section
  class="dbt-demo"
  id="playground"
  data-dbt-playground
  aria-labelledby="playground-title"
  aria-busy="false"
  tabindex="-1"
>
  <header class="demo-intro">
    <div>
      <p class="demo-kicker">
        <span class="demo-kicker-dot" aria-hidden="true"></span>
        Interactive product tour · sample SQLite data stays in this browser
      </p>
      <h2 id="playground-title">Don’t take our word for it. Run the query.</h2>
      <p class="demo-deck">
        This is a working, read-only SQLite database—not a video. Browse tables, follow a foreign
        key, filter a result, and export the rows without leaving this page.
      </p>
    </div>
    <div class="demo-privacy" aria-label="Playground properties">
      <span>WASM powered</span>
      <span>Zero uploads</span>
      <span>No account</span>
    </div>
  </header>

  <div class="demo-window">
    <div class="demo-titlebar">
      <div class="demo-window-dots" aria-hidden="true">
        <i></i><i></i><i></i>
      </div>
      <div class="demo-window-title">
        <span class="demo-mini-mark" aria-hidden="true"><b>&gt;</b><i>_</i></span>
        <span><strong>dbterm</strong><small> / local-demo.sqlite</small></span>
      </div>
      <div class="demo-window-tools">
        <span class="demo-engine" data-demo-engine data-state="idle">
          <i aria-hidden="true"></i>
          <span data-demo-engine-label>Ready on demand</span>
        </span>
        <button class="demo-icon-button" type="button" data-demo-reset title="Reset sample data">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M15.8 5.4A7 7 0 1 0 17 11h-2a5 5 0 1 1-.9-2.9L11.2 11H18V4.2l-2.2 1.2Z"></path>
          </svg>
          <span class="sr-only">Reset sample data</span>
        </button>
      </div>
    </div>

    <div class="demo-shell">
      <aside class="demo-sidebar" aria-label="Sample database objects">
        <div class="demo-sidebar-heading">
          <span>Tables</span>
          <kbd>4</kbd>
        </div>
        <div class="demo-table-list">
          <button type="button" data-demo-table="users" aria-pressed="false">
            <span class="demo-table-glyph" aria-hidden="true">▦</span>
            <span>users</span>
            <small data-demo-table-count="users">8</small>
          </button>
          <button type="button" data-demo-table="orders" aria-pressed="false">
            <span class="demo-table-glyph" aria-hidden="true">▦</span>
            <span>orders</span>
            <small data-demo-table-count="orders">10</small>
          </button>
          <button type="button" data-demo-table="payments" aria-pressed="false">
            <span class="demo-table-glyph" aria-hidden="true">▦</span>
            <span>payments</span>
            <small data-demo-table-count="payments">10</small>
          </button>
          <button type="button" data-demo-table="products" aria-pressed="false">
            <span class="demo-table-glyph" aria-hidden="true">▦</span>
            <span>products</span>
            <small data-demo-table-count="products">6</small>
          </button>
        </div>

        <div class="demo-sidebar-note">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 1.8 3.3 4.4v4.4c0 4.2 2.8 7.8 6.7 9.4 3.9-1.6 6.7-5.2 6.7-9.4V4.4L10 1.8Zm0 2.1 4.8 1.9v3c0 3.1-1.9 5.9-4.8 7.3-2.9-1.4-4.8-4.2-4.8-7.3v-3L10 3.9Z"></path>
          </svg>
          <span><strong>Private by design</strong><small>In-memory and discarded on exit</small></span>
        </div>
      </aside>

      <div class="demo-workspace">
        <section class="demo-editor-panel" aria-labelledby="demo-editor-title">
          <div class="demo-panel-bar">
            <div>
              <span class="demo-panel-index">01</span>
              <h3 id="demo-editor-title">Query editor</h3>
              <span class="demo-readonly">tour sandbox · read-only</span>
            </div>
            <div class="demo-editor-actions">
              <button type="button" data-demo-open-palette>
                Commands <kbd>Ctrl P</kbd>
              </button>
              <button type="button" data-demo-open-filter>
                Filter <kbd>/</kbd>
              </button>
              <button type="button" data-demo-export>
                Export <kbd>Alt E</kbd>
              </button>
              <button type="button" data-demo-open-help aria-label="Open keyboard guide">
                <span aria-hidden="true">?</span>
              </button>
            </div>
          </div>

          <label class="sr-only" for="dbterm-demo-query">SQL query</label>
          <div class="demo-editor-wrap">
            <div class="demo-line-numbers" aria-hidden="true">
              <span>01</span><span>02</span><span>03</span><span>04</span><span>05</span><span>06</span
              ><span>07</span><span>08</span><span>09</span><span>10</span><span>11</span><span>12</span>
            </div>
            <textarea
              id="dbterm-demo-query"
              data-demo-editor
              spellcheck="false"
              autocapitalize="off"
              autocomplete="off"
              aria-describedby="demo-query-policy"
            ></textarea>
          </div>
          <div class="demo-editor-footer">
            <p id="demo-query-policy">
              <span aria-hidden="true">●</span> Real SQLite <span aria-hidden="true">·</span> SELECT,
              WITH, EXPLAIN &amp; PRAGMA
            </p>
            <button class="demo-run" type="button" data-demo-run>
              <span class="demo-run-icon" aria-hidden="true">▶</span>
              <span data-demo-run-label>Run query</span>
              <kbd>Ctrl ↵</kbd>
            </button>
          </div>
        </section>

        <section class="demo-results-panel" aria-labelledby="demo-results-title">
          <div class="demo-panel-bar demo-results-bar">
            <div>
              <span class="demo-panel-index">02</span>
              <h3 id="demo-results-title">Results</h3>
              <span class="demo-filter-chip" data-demo-filter-chip hidden>
                <span data-demo-filter-text></span>
                <button type="button" data-demo-clear-filter aria-label="Clear result filter">×</button>
              </span>
            </div>
            <dl class="demo-result-meta">
              <div><dt class="sr-only">Rows</dt><dd data-demo-row-count>— rows</dd></div>
              <div><dt class="sr-only">Execution time</dt><dd data-demo-duration>— ms</dd></div>
              <div><dt class="sr-only">Engine version</dt><dd data-demo-engine-version>SQLite WASM</dd></div>
            </dl>
          </div>

          <div class="demo-result-scroller" data-demo-result-scroller>
            <table class="demo-result-table" data-demo-result-table hidden>
              <caption class="sr-only">SQLite query results. Select a cell with the arrow keys.</caption>
              <thead data-demo-result-head></thead>
              <tbody data-demo-result-body></tbody>
            </table>
            <div class="demo-empty" data-demo-empty>
              <div class="demo-empty-orbit" aria-hidden="true">
                <span></span><i></i><b>&gt;_</b>
              </div>
              <div>
                <strong data-demo-empty-title>SQLite is standing by</strong>
                <p data-demo-empty-message>Run the query to wake the in-browser SQLite engine.</p>
              </div>
            </div>
          </div>

          <div class="demo-result-footer" aria-hidden="true">
            <span><kbd>↑↓←→</kbd> select</span>
            <span><kbd>C</kbd> copy</span>
            <span><kbd>V</kbd> filter clipboard</span>
            <span><kbd>F</kbd> follow key</span>
            <span><kbd>⌫</kbd> back</span>
          </div>
        </section>
      </div>
    </div>

    <nav class="demo-mobile-actions" aria-label="Playground actions">
      <button type="button" data-demo-open-palette><span aria-hidden="true">⌘</span> Commands</button>
      <button type="button" data-demo-open-filter><span aria-hidden="true">⌕</span> Filter</button>
      <button type="button" data-demo-export><span aria-hidden="true">⇩</span> Export</button>
      <button type="button" data-demo-open-help><span aria-hidden="true">?</span> Help</button>
    </nav>
  </div>

  <p class="demo-live" data-demo-status role="status" aria-live="polite">
    Demo ready. Run a query to load SQLite.
  </p>

  <dialog class="demo-dialog demo-palette" data-demo-palette-dialog aria-labelledby="demo-palette-title">
    <div class="demo-dialog-topline">
      <div>
        <span class="demo-dialog-kicker">Command palette</span>
        <h3 id="demo-palette-title">Go anywhere. Do anything.</h3>
      </div>
      <form method="dialog"><button type="submit" aria-label="Close command palette">×</button></form>
    </div>
    <div class="demo-combobox">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="m14.5 13.1 4 4-1.4 1.4-4-4a7 7 0 1 1 1.4-1.4ZM3 9a5 5 0 1 0 10 0A5 5 0 0 0 3 9Z"></path>
      </svg>
      <input
        data-demo-palette-input
        type="text"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="demo-palette-listbox"
        placeholder="Search actions, tables, and workflows…"
        autocomplete="off"
      />
      <kbd>Esc</kbd>
    </div>
    <div
      class="demo-palette-list"
      id="demo-palette-listbox"
      data-demo-palette-list
      role="listbox"
      aria-label="Available commands"
    ></div>
    <div class="demo-dialog-footer">
      <span><kbd>↑↓</kbd> navigate</span>
      <span><kbd>↵</kbd> run</span>
      <span class="demo-dialog-footer-note">Fuzzy search includes descriptions</span>
    </div>
  </dialog>

  <dialog class="demo-dialog demo-filter-dialog" data-demo-filter-dialog aria-labelledby="demo-filter-title">
    <form data-demo-filter-form>
      <div class="demo-dialog-topline">
        <div>
          <span class="demo-dialog-kicker">Result scope</span>
          <h3 id="demo-filter-title">Filter visible rows</h3>
        </div>
        <button type="button" data-demo-filter-close aria-label="Close filter">×</button>
      </div>
      <p class="demo-dialog-deck">Compose a temporary filter without changing the SQL or sample data.</p>
      <div class="demo-filter-grid">
        <label>
          <span>Column</span>
          <select data-demo-filter-column></select>
        </label>
        <label>
          <span>Operator</span>
          <select data-demo-filter-operator>
            <option value="contains">contains</option>
            <option value="equals">equals</option>
            <option value="starts">starts with</option>
            <option value="greater">is greater than</option>
            <option value="less">is less than</option>
          </select>
        </label>
        <label class="demo-filter-value">
          <span>Value</span>
          <input data-demo-filter-value type="text" placeholder="e.g. paid" autocomplete="off" />
        </label>
      </div>
      <div class="demo-dialog-actions">
        <button class="demo-dialog-secondary" type="button" data-demo-filter-reset>Clear filter</button>
        <button class="demo-dialog-primary" type="submit">Apply filter</button>
      </div>
    </form>
  </dialog>

  <dialog class="demo-dialog demo-help-dialog" data-demo-help-dialog aria-labelledby="demo-help-title">
    <div class="demo-dialog-topline">
      <div>
        <span class="demo-dialog-kicker">Keyboard guide</span>
        <h3 id="demo-help-title">The fast path through dbterm</h3>
      </div>
      <form method="dialog">
        <button type="submit" data-demo-help-close aria-label="Close keyboard guide">×</button>
      </form>
    </div>
    <p class="demo-dialog-deck">
      Shortcuts activate only while focus is inside this tour. Your browser keeps its normal keys everywhere else.
    </p>
    <div class="demo-shortcut-grid">
      <div><kbd>Ctrl P</kbd><span><strong>Command palette</strong><small>Fuzzy-find actions and tables</small></span></div>
      <div><kbd>Ctrl ↵</kbd><span><strong>Run query</strong><small>Execute editor contents</small></span></div>
      <div><kbd>/</kbd><span><strong>Filter results</strong><small>Compose a scoped row filter</small></span></div>
      <div><kbd>C</kbd><span><strong>Copy cell</strong><small>Copy the selected value</small></span></div>
      <div><kbd>V</kbd><span><strong>Filter from clipboard</strong><small>Exact-match the selected column</small></span></div>
      <div><kbd>F</kbd><span><strong>Follow foreign key</strong><small>Open users, orders, or products</small></span></div>
      <div><kbd>⌫</kbd><span><strong>Go back</strong><small>Return to the previous result</small></span></div>
      <div><kbd>Alt E</kbd><span><strong>Export CSV</strong><small>Download visible rows</small></span></div>
      <div><kbd>Alt H</kbd><span><strong>Open this guide</strong><small>Help is always one chord away</small></span></div>
      <div><kbd>Ctrl C</kbd><span><strong>Cancel loading</strong><small>Stop a pending tour query</small></span></div>
    </div>
  </dialog>
</section>

<script>
  import { mountInteractiveDemo } from "../scripts/interactive-demo";

  document.querySelectorAll("[data-dbt-playground]").forEach((node) => {
    if (node instanceof HTMLElement) mountInteractiveDemo(node);
  });
</script>

<style>
  .dbt-demo {
    --demo-bg: #f3f1e9;
    --demo-surface: #fffef9;
    --demo-surface-soft: #f8f7f1;
    --demo-surface-raised: #ffffff;
    --demo-ink: #18211c;
    --demo-ink-soft: #4e5b53;
    --demo-ink-faint: #7b867f;
    --demo-border: #d9ddd6;
    --demo-border-strong: #bdc6bd;
    --demo-accent: #18734e;
    --demo-accent-strong: #0d5c3d;
    --demo-accent-soft: #dff3e8;
    --demo-lime: #a4ec80;
    --demo-violet: #7149a8;
    --demo-violet-soft: #eee6f8;
    --demo-error: #a23b35;
    --demo-error-soft: #fbe8e4;
    --demo-shadow: 0 38px 90px rgba(36, 50, 42, 0.16), 0 7px 20px rgba(36, 50, 42, 0.08);
    position: relative;
    isolation: isolate;
    margin-block: clamp(5rem, 10vw, 9rem);
    color: var(--demo-ink);
    color-scheme: light;
    font-family: var(--font-sans, "Inter", "Segoe UI", sans-serif);
  }

  :global([data-theme="dark"]) .dbt-demo {
    --demo-bg: #111711;
    --demo-surface: #161d18;
    --demo-surface-soft: #1b241e;
    --demo-surface-raised: #212b24;
    --demo-ink: #eff7ef;
    --demo-ink-soft: #b2c0b5;
    --demo-ink-faint: #839187;
    --demo-border: #344039;
    --demo-border-strong: #4b5b50;
    --demo-accent: #9ce978;
    --demo-accent-strong: #b6f598;
    --demo-accent-soft: #203c2b;
    --demo-violet: #c19ae7;
    --demo-violet-soft: #352940;
    --demo-error: #ffaaa1;
    --demo-error-soft: #422725;
    --demo-shadow: 0 42px 100px rgba(0, 0, 0, 0.42), 0 8px 24px rgba(0, 0, 0, 0.25);
    color-scheme: dark;
  }

  .dbt-demo::before {
    position: absolute;
    inset: 6rem -5vw -3rem;
    z-index: -2;
    border-radius: 4rem;
    background:
      radial-gradient(circle at 12% 16%, color-mix(in srgb, var(--demo-accent) 13%, transparent), transparent 30%),
      radial-gradient(circle at 88% 80%, color-mix(in srgb, var(--demo-violet) 12%, transparent), transparent 32%);
    content: "";
    pointer-events: none;
  }

  .demo-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    align-items: end;
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .demo-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    color: var(--demo-accent-strong);
    font-family: var(--font-mono, "IBM Plex Mono", monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .demo-kicker-dot {
    width: 0.52rem;
    height: 0.52rem;
    border-radius: 50%;
    background: var(--demo-accent);
    box-shadow: 0 0 0 0.25rem var(--demo-accent-soft);
  }

  .demo-intro h2 {
    max-width: 17ch;
    margin: 0;
    color: var(--demo-ink);
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .demo-deck {
    max-width: 62ch;
    margin: 1.15rem 0 0;
    color: var(--demo-ink-soft);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.65;
  }

  .demo-privacy {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.55rem;
  }

  .demo-privacy span {
    padding: 0.48rem 0.72rem;
    border: 1px solid var(--demo-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--demo-surface) 82%, transparent);
    color: var(--demo-ink-soft);
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .demo-window {
    overflow: hidden;
    border: 1px solid var(--demo-border-strong);
    border-radius: clamp(1rem, 2vw, 1.55rem);
    background: var(--demo-surface);
    box-shadow: var(--demo-shadow);
  }

  .demo-titlebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--demo-border);
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--demo-surface-raised) 96%, transparent), var(--demo-surface-soft));
  }

  .demo-window-dots {
    display: flex;
    gap: 0.42rem;
  }

  .demo-window-dots i {
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid color-mix(in srgb, var(--demo-ink) 20%, transparent);
    border-radius: 50%;
    background: var(--demo-border);
  }

  .demo-window-dots i:first-child { background: #f08c78; }
  .demo-window-dots i:nth-child(2) { background: #eebd67; }
  .demo-window-dots i:nth-child(3) { background: #76c993; }

  .demo-window-title {
    display: flex;
    align-items: center;
    gap: 0.62rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.73rem;
  }

  .demo-window-title small {
    color: var(--demo-ink-faint);
    font-size: inherit;
  }

  .demo-mini-mark {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    justify-content: center;
    width: 1.78rem;
    height: 1.78rem;
    border-radius: 0.42rem;
    background: #132319;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    line-height: 1;
  }

  .demo-mini-mark b { color: #d7b9ff; }
  .demo-mini-mark i { color: var(--demo-lime); font-style: normal; }

  .demo-window-tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .demo-engine {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--demo-ink-faint);
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .demo-engine i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--demo-border-strong);
  }

  .demo-engine[data-state="loading"] i {
    border: 1px solid var(--demo-accent);
    border-top-color: transparent;
    background: transparent;
    animation: demo-spin 700ms linear infinite;
  }

  .demo-engine[data-state="ready"] { color: var(--demo-accent-strong); }
  .demo-engine[data-state="ready"] i { background: var(--demo-accent); box-shadow: 0 0 0 0.2rem var(--demo-accent-soft); }
  .demo-engine[data-state="error"] { color: var(--demo-error); }
  .demo-engine[data-state="error"] i { background: var(--demo-error); }

  .demo-icon-button,
  .demo-editor-actions button,
  .demo-table-list button,
  .demo-mobile-actions button {
    appearance: none;
    border: 0;
    color: inherit;
    font: inherit;
  }

  .demo-icon-button {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--demo-border);
    border-radius: 0.46rem;
    background: var(--demo-surface-raised);
    cursor: pointer;
  }

  .demo-icon-button svg { width: 0.95rem; fill: currentColor; }

  .demo-shell {
    display: grid;
    grid-template-columns: 12.2rem minmax(0, 1fr);
    min-height: 43rem;
  }

  .demo-sidebar {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.2rem 0.8rem;
    border-right: 1px solid var(--demo-border);
    background: var(--demo-surface-soft);
  }

  .demo-sidebar-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.65rem 0.7rem;
    color: var(--demo-ink-faint);
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .demo-sidebar-heading kbd,
  .demo-result-footer kbd,
  .demo-editor-actions kbd,
  .demo-run kbd,
  .demo-dialog kbd {
    border: 1px solid var(--demo-border);
    border-bottom-color: var(--demo-border-strong);
    border-radius: 0.3rem;
    background: var(--demo-surface-raised);
    box-shadow: 0 1px 0 var(--demo-border);
    color: var(--demo-ink-faint);
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    font-weight: 600;
    line-height: 1;
  }

  .demo-sidebar-heading kbd { padding: 0.22rem 0.36rem; }

  .demo-table-list {
    display: grid;
    gap: 0.28rem;
  }

  .demo-table-list button {
    display: grid;
    grid-template-columns: 1.3rem 1fr auto;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    min-height: 2.35rem;
    padding: 0.45rem 0.58rem;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--demo-ink-soft);
    cursor: pointer;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    text-align: left;
    transition: 140ms ease;
  }

  .demo-table-list button:hover {
    border-color: var(--demo-border);
    background: var(--demo-surface-raised);
