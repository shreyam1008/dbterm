<section
  class="dbt-demo"
  id="playground"
  data-dbt-playground
  aria-labelledby="playground-title"
  aria-busy="false"
  tabindex="-1"
>
  <header class="demo-intro">
    <div>
      <p>Browser demo</p>
      <h2 id="playground-title">Try dbterm.</h2>
    </div>
    <div class="demo-intro-copy">
      <p>Real read-only SQLite. The same workspace and core keys as dbterm.</p>
      <span>Press Ctrl+P anywhere on this page, or click inside for contextual keys.</span>
    </div>
  </header>

  <div class="demo-browser-bar">
    <span><i aria-hidden="true"></i> sample SQLite session · data stays in this browser</span>
    <button type="button" data-demo-reset><span aria-hidden="true">↻</span> Reset sample</button>
  </div>

  <div class="demo-terminal" data-demo-terminal data-focus="tables">
    <div class="demo-terminal-titlebar" aria-hidden="true">
      <span>dbterm 132×40</span>
      <span>v0.6.0 · Mahanadi</span>
    </div>

    <div class="demo-workspace" data-demo-workspace>
      <aside
        class="demo-panel demo-tables-panel"
        data-demo-panel="tables"
        data-active="true"
        aria-label="Sample database tables"
        tabindex="0"
      >
        <div class="demo-panel-title">
          <span aria-hidden="true">📚</span>
          <span data-demo-tables-title>Tables (4)</span>
          <em>(Alt+T)</em>
        </div>
        <div class="demo-table-list" role="listbox" aria-label="Tables">
          <button type="button" role="option" data-demo-table="users" aria-selected="true" tabindex="0">
            <span data-demo-table-label>users</span><small data-demo-table-count="users">8</small>
          </button>
          <button type="button" role="option" data-demo-table="orders" aria-selected="false" tabindex="-1">
            <span data-demo-table-label>orders</span><small data-demo-table-count="orders">10</small>
          </button>
          <button type="button" role="option" data-demo-table="payments" aria-selected="false" tabindex="-1">
            <span data-demo-table-label>payments</span><small data-demo-table-count="payments">10</small>
          </button>
          <button type="button" role="option" data-demo-table="products" aria-selected="false" tabindex="-1">
            <span data-demo-table-label>products</span><small data-demo-table-count="products">6</small>
          </button>
        </div>
      </aside>

      <div class="demo-right">
        <section class="demo-panel demo-query-panel" data-demo-panel="query" data-active="false" aria-labelledby="demo-query-title">
          <div class="demo-panel-title">
            <span aria-hidden="true">📝</span>
            <span id="demo-query-title">Query</span>
            <em>(Alt+Q)</em>
          </div>
          <label class="sr-only" for="dbterm-demo-query">SQL query</label>
          <textarea
            id="dbterm-demo-query"
            data-demo-editor
            spellcheck="false"
            autocapitalize="off"
            autocomplete="off"
            placeholder="Write SQL here — Enter to run, Shift+Enter for newline"
          ></textarea>
        </section>

        <section class="demo-panel demo-results-panel" data-demo-panel="results" data-active="false" aria-labelledby="demo-results-title" tabindex="-1">
          <div class="demo-panel-title demo-results-title">
            <span aria-hidden="true">📊</span>
            <span id="demo-results-title" data-demo-results-title>Results</span>
            <span class="demo-filter-chip" data-demo-filter-chip hidden>
              <span data-demo-filter-text></span>
              <button type="button" data-demo-clear-filter aria-label="Clear all result filters">×</button>
            </span>
          </div>

          <div class="demo-result-scroller" data-demo-result-scroller>
            <table class="demo-result-table" data-demo-result-table hidden>
              <caption class="sr-only">SQLite query results. Select a cell with the arrow keys.</caption>
              <thead data-demo-result-head></thead>
              <tbody data-demo-result-body></tbody>
            </table>
            <div class="demo-empty" data-demo-empty>
              <strong data-demo-empty-title>SQLite is standing by</strong>
              <p data-demo-empty-message>Opening the users table…</p>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="demo-statusbar">
      <span class="demo-engine" data-demo-engine data-state="idle">
        <b>◆ SQLite</b><i aria-hidden="true"></i><span data-demo-engine-label>starting</span>
      </span>
      <span>🔌 local-demo</span>
      <span>4 tables</span>
      <span data-demo-row-count>— rows</span>
      <span data-demo-duration>— ms</span>
      <span data-demo-engine-version hidden>SQLite WASM</span>
      <span data-demo-sort-status>sort: none</span>
      <button type="button" data-demo-run><kbd>Enter</kbd> Run ▶</button>
      <button type="button" data-demo-open-palette><kbd>Ctrl+P</kbd> Palette</button>
      <button type="button" data-demo-open-help><kbd>Alt+H</kbd> Help</button>
      <span class="demo-live" data-demo-status role="status" aria-live="polite">Tables focused · type to find</span>
    </div>

    <div class="demo-loading" data-demo-loading hidden aria-hidden="true">
      <div>
        <strong><span aria-hidden="true">↻</span> <span data-demo-loading-title>Loading…</span></strong>
        <p data-demo-loading-message>Press Esc to cancel.</p>
      </div>
    </div>
  </div>

  <p class="demo-aftercare">
    Try <kbd>Ctrl P</kbd>, table type-ahead, <kbd>/</kbd>, <kbd>C</kbd>, <kbd>V</kbd>, <kbd>F</kbd>, and <kbd>Backspace</kbd>.
    <a href="./guide/">All shortcuts →</a>
  </p>

  <dialog class="demo-dialog demo-palette" data-demo-palette-dialog aria-labelledby="demo-palette-title">
    <div class="demo-modal-shell">
      <label class="demo-search-frame">
        <span id="demo-palette-title">Command &amp; Object Palette <em>(Ctrl+P)</em></span>
        <span class="demo-search-row"><b>Search</b><input data-demo-palette-input type="text" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="demo-palette-listbox" placeholder="commands, tables, and workflows…" autocomplete="off" /></span>
      </label>
      <section class="demo-modal-panel demo-matches-panel" aria-label="Command matches">
        <h3>Matches</h3>
        <div class="demo-palette-list" id="demo-palette-listbox" data-demo-palette-list role="listbox"></div>
      </section>
      <section class="demo-modal-panel demo-selected-panel" aria-label="Selected command details">
        <h3>Selected Item</h3>
        <div data-demo-palette-detail></div>
      </section>
      <footer><kbd>Type</kbd> Search <i>│</i> <kbd>↑/↓</kbd> Navigate <i>│</i> <kbd>Enter</kbd> Open <i>│</i> <kbd>Esc</kbd> Close</footer>
    </div>
  </dialog>

  <dialog class="demo-dialog demo-filter-dialog" data-demo-filter-dialog aria-labelledby="demo-filter-title">
    <form class="demo-modal-shell" data-demo-filter-form>
      <section class="demo-filter-frame">
        <h3 id="demo-filter-title" data-demo-filter-title>📊 Filters</h3>
        <label><span>Value</span><input data-demo-filter-value type="text" placeholder="type a comparison value" autocomplete="off" /></label>
        <label><span>Operator</span><select data-demo-filter-operator>
          <option value="equals">=</option>
          <option value="not-equals">!=</option>
          <option value="greater">&gt;</option>
          <option value="greater-equal">&gt;=</option>
          <option value="less">&lt;</option>
          <option value="less-equal">&lt;=</option>
          <option value="contains">contains</option>
          <option value="starts">starts-with</option>
          <option value="is-null">IS NULL</option>
          <option value="is-not-null">IS NOT NULL</option>
        </select></label>
        <label class="sr-only"><span>Column</span><select data-demo-filter-column></select></label>
        <div class="demo-filter-actions">
          <button type="submit">Apply</button>
          <button type="button" data-demo-filter-add>Add AND</button>
          <button type="button" data-demo-filter-clipboard>Use Clipboard</button>
          <button type="button" data-demo-filter-remove>Remove Last</button>
          <button type="button" data-demo-filter-reset>Clear All</button>
          <button type="button" data-demo-filter-close>Cancel</button>
        </div>
      </section>
      <div class="demo-active-filters" data-demo-active-filters>Active filters: none</div>
      <footer><kbd>Enter</kbd> Apply <i>│</i> <kbd>Tab / Shift+Tab</kbd> Move <i>│</i> <kbd>Esc</kbd> Cancel</footer>
    </form>
  </dialog>

  <dialog class="demo-dialog demo-help-dialog" data-demo-help-dialog aria-labelledby="demo-help-title">
    <div class="demo-modal-shell">
      <section class="demo-help-frame">
        <div class="demo-help-heading"><h3 id="demo-help-title">❓ Help &amp; Cheatsheets</h3><button type="button" data-demo-help-close aria-label="Close help">×</button></div>
        <div class="demo-help-grid">
          <div><kbd>Tab</kbd><span>Cycle Tables → Query → Results</span></div>
          <div><kbd>Alt+T/Q/R</kbd><span>Focus a panel</span></div>
          <div><kbd>Enter</kbd><span>Run SQL / open row details</span></div>
          <div><kbd>Shift+Enter</kbd><span>New query line</span></div>
          <div><kbd>Ctrl+P</kbd><span>Command &amp; object palette</span></div>
          <div><kbd>/</kbd><span>Filter selected column</span></div>
          <div><kbd>C / V</kbd><span>Copy cell / filter by clipboard</span></div>
          <div><kbd>F / Backspace</kbd><span>Follow foreign key / return</span></div>
          <div><kbd>S</kbd><span>Sort selected column</span></div>
          <div><kbd>Alt+E</kbd><span>Export visible rows to CSV</span></div>
          <div><kbd>Alt+F</kbd><span>Fullscreen Results</span></div>
          <div><kbd>Esc</kbd><span>Clear search or filters</span></div>
        </div>
      </section>
      <footer><kbd>Esc / Alt+H</kbd> Close</footer>
    </div>
  </dialog>

  <dialog class="demo-dialog demo-detail-dialog" data-demo-detail-dialog aria-labelledby="demo-detail-title">
    <div class="demo-modal-shell">
      <section class="demo-detail-frame">
        <div class="demo-help-heading"><h3 id="demo-detail-title">📄 Row Details</h3><button type="button" data-demo-detail-close aria-label="Close row details">×</button></div>
        <dl data-demo-detail-list></dl>
      </section>
      <footer><kbd>↑/↓</kbd> Scroll <i>│</i> <kbd>Esc / Enter</kbd> Close</footer>
    </div>
  </dialog>
</section>

<script>
  import { mountInteractiveDemo } from "../scripts/interactive-demo";
  document.querySelectorAll("[data-dbt-playground]").forEach((node) => {
    if (node instanceof HTMLElement) mountInteractiveDemo(node);
  });
</script>

<style>
  .dbt-demo {
    --tui-base: #1e1e2e;
    --tui-mantle: #181825;
    --tui-crust: #11111b;
    --tui-surface-0: #313244;
    --tui-surface-1: #45475a;
    --tui-text: #cdd6f4;
    --tui-subtext: #a6adc8;
    --tui-overlay: #6c7086;
    --tui-green: #a6e3a1;
    --tui-blue: #89b4fa;
    --tui-mauve: #cba6f7;
    --tui-peach: #ffb496;
    --tui-yellow: #f9e2af;
    --tui-teal: #94e2d5;
    --tui-red: #f38ba8;
    color: var(--ink);
  }

  .demo-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, .72fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-bottom: 1.75rem;
  }

  .demo-intro > div:first-child > p {
    margin: 0 0 .65rem;
    color: var(--brand-strong);
    font: 650 .68rem/1.2 var(--font-mono);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .demo-intro h2 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: .95;
    letter-spacing: -.06em;
  }

  .demo-intro-copy p {
    margin: 0 0 .4rem;
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .demo-intro-copy span {
    color: var(--ink-faint);
    font: .68rem/1.4 var(--font-mono);
  }

  .demo-browser-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    min-height: 2.55rem;
    border: 1px solid var(--line-strong);
    border-bottom: 0;
    border-radius: .8rem .8rem 0 0;
    background: var(--surface);
    padding: .5rem .8rem;
    color: var(--ink-soft);
    font: .65rem/1.2 var(--font-mono);
  }

  .demo-browser-bar span { display: flex; align-items: center; gap: .45rem; }
  .demo-browser-bar i { width: .45rem; height: .45rem; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 12%, transparent); }
  .demo-browser-bar button { border: 0; background: transparent; color: var(--brand-strong); font: inherit; font-weight: 650; cursor: pointer; }

  .demo-terminal {
    position: relative;
    overflow: hidden;
    border: 1px solid #45475a;
    border-radius: 0 0 .8rem .8rem;
    background: var(--tui-base);
    color: var(--tui-text);
    box-shadow: 0 28px 80px rgb(24 24 37 / 20%);
    font-family: var(--font-mono);
  }

  .demo-terminal kbd {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 0;
    color: inherit;
    font: inherit;
  }

  .demo-terminal-titlebar {
    display: flex;
    justify-content: center;
    min-height: 1.7rem;
    padding: .28rem .65rem;
    background: #b30000;
    color: #fff;
    font-size: .68rem;
  }

  .demo-terminal-titlebar span:last-child { margin-left: auto; color: #fff; }

  .demo-workspace {
    display: grid;
    grid-template-columns: clamp(12.5rem, 22vw, 17rem) minmax(0, 1fr);
    min-height: 34rem;
    padding: .55rem .3rem .3rem;
  }

  .demo-right {
    display: grid;
    grid-template-rows: minmax(7.2rem, .22fr) minmax(0, 1fr);
    min-width: 0;
  }

  .demo-panel {
    position: relative;
    min-width: 0;
    margin: .28rem;
    border: 1px solid var(--tui-surface-1);
    background: var(--tui-base);
    outline: none;
  }

  .demo-panel-title {
    position: absolute;
    z-index: 2;
    top: -.66rem;
    left: 50%;
    display: flex;
    max-width: calc(100% - 1rem);
    align-items: center;
    gap: .35rem;
    transform: translateX(-50%);
    background: var(--tui-base);
    padding: 0 .5rem;
    color: var(--tui-peach);
    font-size: .72rem;
    white-space: nowrap;
  }

  .demo-panel-title em { color: var(--tui-subtext); font-style: normal; }
  .demo-panel[data-demo-panel="tables"][data-active="true"] { border-color: var(--tui-mauve); }
  .demo-panel[data-demo-panel="query"][data-active="true"] { border-color: var(--tui-blue); }
  .demo-panel[data-demo-panel="results"][data-active="true"] { border-color: var(--tui-green); }

  .demo-table-list { display: grid; align-content: start; padding: 1rem .2rem .35rem; }
  .demo-table-list button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: .7rem;
    width: 100%;
    border: 0;
    background: transparent;
    padding: .28rem .35rem;
    color: var(--tui-text);
    text-align: left;
    font: .72rem/1.35 var(--font-mono);
    cursor: pointer;
  }

  .demo-table-list button small { color: var(--tui-subtext); font: inherit; }
  .demo-table-list button:hover { background: var(--tui-surface-0); }
  .demo-table-list button[aria-selected="true"] { background: var(--tui-blue); color: var(--tui-crust); }
  .demo-table-list button[aria-selected="true"] small { color: var(--tui-crust); }
  :global(.dbt-demo .demo-table-list mark) { background: var(--tui-yellow); color: var(--tui-crust); font-weight: 700; }

  .demo-query-panel textarea {
    width: 100%;
    height: 100%;
    min-height: 7rem;
    resize: none;
    border: 0;
    outline: 0;
    background: #00363d;
    padding: 1rem .75rem .5rem;
    color: var(--tui-text);
    caret-color: var(--tui-green);
    font: .75rem/1.45 var(--font-mono);
  }

  .demo-query-panel textarea::placeholder { color: #4f7684; opacity: 1; }
  .demo-results-title { max-width: calc(100% - 2rem); }
  .demo-filter-chip { display: inline-flex; min-width: 0; align-items: center; gap: .25rem; color: var(--tui-yellow); }
  .demo-filter-chip > span { max-width: 26rem; overflow: hidden; text-overflow: ellipsis; }
  .demo-filter-chip button { border: 0; background: transparent; color: var(--tui-red); cursor: pointer; font: inherit; }

  .demo-result-scroller {
    height: 100%;
    min-height: 24rem;
    overflow: auto;
    padding-top: .55rem;
    scrollbar-color: var(--tui-surface-1) var(--tui-base);
  }

  .demo-result-table {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    color: var(--tui-text);
    font: .69rem/1.35 var(--font-mono);
  }

  :global(.dbt-demo .demo-result-table th),
  :global(.dbt-demo .demo-result-table td) { border: 1px solid #a6adc8; padding: 0; white-space: nowrap; }
  :global(.dbt-demo .demo-result-table th) { position: sticky; z-index: 1; top: 0; min-width: 8rem; background: var(--tui-mantle); padding: .36rem .48rem; color: var(--tui-peach); text-align: left; text-transform: uppercase; }
  :global(.dbt-demo .demo-result-table th:first-child) { min-width: 4.5rem; }
  :global(.dbt-demo .demo-result-table td > button) { display: block; width: 100%; min-width: 8rem; max-width: 20rem; overflow: hidden; border: 0; background: transparent; padding: .38rem .5rem; color: var(--tui-text); text-align: left; text-overflow: ellipsis; white-space: nowrap; font: inherit; cursor: cell; }
  :global(.dbt-demo .demo-result-table td:first-child > button) { min-width: 4.5rem; }
  :global(.dbt-demo .demo-result-table td > button[data-selected="true"]) { background: var(--tui-blue); color: var(--tui-crust); }
  :global(.dbt-demo .demo-result-table td > button.is-null) { color: var(--tui-overlay); font-style: italic; }
  :global(.dbt-demo .demo-result-table td > button.is-number:not([data-selected="true"])) { color: var(--tui-teal); }
  :global(.dbt-demo .demo-result-table td > button.is-linkable:not([data-selected="true"])) { color: var(--tui-teal); }
  :global(.dbt-demo .demo-result-table tr[data-row-selected="true"] td:first-child) { box-shadow: 3px 0 0 var(--tui-yellow) inset; }
  :global(.dbt-demo .demo-no-matches) { padding: 1rem !important; color: var(--tui-overlay); text-align: center; }

  .demo-empty { display: grid; min-height: 23rem; place-content: center; gap: .3rem; padding: 2rem; color: var(--tui-subtext); text-align: center; }
