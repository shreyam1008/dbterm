  }

  .demo-loading[hidden] { display: none; }
  .demo-loading > div { width: min(30rem, calc(100% - 2rem)); border: 1px solid var(--tui-mauve); background: var(--tui-base); padding: 1.3rem; box-shadow: 0 20px 60px rgb(0 0 0 / 45%); text-align: center; }
  .demo-loading strong { color: var(--tui-mauve); font-size: .82rem; }
  .demo-loading strong span:first-child { display: inline-block; animation: demo-spin 1s linear infinite; }
  .demo-loading p { margin: .7rem 0 0; color: var(--tui-subtext); font-size: .68rem; }

  .demo-aftercare { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem 1.5rem; margin: 1rem 0 0; color: var(--ink-faint); font: .66rem/1.5 var(--font-mono); }
  .demo-aftercare kbd { color: var(--brand-strong); font-weight: 700; }
  .demo-aftercare a { color: var(--brand-strong); }

  .demo-dialog {
    width: min(62rem, calc(100vw - 1.5rem));
    max-height: calc(100vh - 1.5rem);
    overflow: auto;
    border: 1px solid var(--tui-mauve);
    border-radius: 0;
    background: var(--tui-base);
    padding: 0;
    color: var(--tui-text);
    box-shadow: 0 30px 100px rgb(0 0 0 / 60%);
    font-family: var(--font-mono);
  }

  .demo-dialog::backdrop { background: rgb(17 17 27 / 72%); backdrop-filter: blur(2px); }
