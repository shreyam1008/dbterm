---
import BaseLayout from "../layouts/BaseLayout.astro";
import * as guide from "../../../docs/user-guide.md";
import { currentRelease } from "../lib/release";

const title = "dbterm Documentation | Complete User Guide and CLI Reference";
const description =
  "Complete dbterm documentation for installation, connections, SQL, results, Change Profiler, backup and restore, MCP agents, settings, CLI commands, security, and troubleshooting.";

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  const trimmedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  const trimmedPath = path.startsWith("/") ? path.slice(1) : path;
  return `${trimmedBase}/${trimmedPath}`.replace(/\/{2,}/g, "/");
};

const { Content } = guide;
const headings = guide.getHeadings();
const sections = headings.filter((heading) => heading.depth === 2);
const canonical = "https://dbterm.shreyam1008.com.np/guide/";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "Complete dbterm user guide",
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: "2026-08-20",
  dateModified: "2026-08-20",
  inLanguage: "en",
  author: {
    "@type": "Person",
    name: "Shreyam Adhikari",
    alternateName: "shreyam1008",
    url: "https://shreyam1008.com.np/",
    sameAs: ["https://github.com/shreyam1008"]
  },
  about: {
    "@type": "SoftwareApplication",
    name: "dbterm",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS, Windows",
    softwareVersion: currentRelease.version,
    codeRepository: "https://github.com/shreyam1008/dbterm"
  },
  image: "https://dbterm.shreyam1008.com.np/assets/command-palette.png"
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "dbterm",
      item: "https://dbterm.shreyam1008.com.np/"
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Documentation",
      item: canonical
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
  markdownUrl={withBase("/guide.md")}
>
  <section class="hero-panel docs-hero" aria-labelledby="guide-title">
    <p class="eyebrow">Complete manual · dbterm {currentRelease.label}</p>
    <h1 id="guide-title">dbterm documentation</h1>
    <p>
      One operational reference for installing dbterm, connecting every supported database,
      using the TUI and CLI, protecting data, and connecting trusted local agents.
    </p>
    <div class="docs-actions" aria-label="Documentation formats and focused guides">
      <a class="button primary" href="#start-here">Read the manual</a>
      <a class="button outline" href={withBase("/guide.md")}>Plain Markdown</a>
      <a class="button outline" href={withBase("/backup.md")}>Backup handbook</a>
      <a class="button outline" href={withBase("/agents.md")}>Agent guide</a>
    </div>
    <div class="page-meta" aria-label="Guide metadata">
      <span>Maintained by <a href="https://shreyam1008.com.np/">Shreyam Adhikari</a></span>
      <span>Updated 20 August 2026</span>
      <span>{sections.length} documented topics</span>
      <span>Static HTML + Markdown</span>
      <span>Offline guide: Alt+H</span>
    </div>
  </section>

  <div class="docs-layout">
    <aside class="docs-sidebar" aria-label="Documentation table of contents">
      <nav>
        <p class="section-label">On this page</p>
        <ol>
          {sections.map((section) => (
            <li><a href={`#${section.slug}`}>{section.text}</a></li>
          ))}
        </ol>
      </nav>
      <div class="docs-sidebar-links">
        <strong>Focused references</strong>
        <a href={withBase("/backup/")}>Backup overview</a>
        <a href={withBase("/agents/")}>AI agents and MCP</a>
        <a href="https://github.com/shreyam1008/dbterm/releases">Release history</a>
        <a href="https://github.com/shreyam1008/dbterm/issues">Report a problem</a>
      </div>
    </aside>

    <article class="docs-content" aria-label="Complete dbterm user guide">
      <Content />
    </article>
  </div>
</BaseLayout>
