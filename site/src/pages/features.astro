---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "dbterm Features | Browse, Compare & Back Up Databases";
const description =
  "Connect to PostgreSQL, MySQL, MariaDB, SQLite, Turso, or D1; inspect data, follow relationships, compare changes, and run verified backups from one terminal.";

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  const trimmedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  const trimmedPath = path.startsWith("/") ? path.slice(1) : path;
  return `${trimmedBase}/${trimmedPath}`.replace(/\/{2,}/g, "/");
};

const features = [
  {
    id: "connect",
    step: "01",
    label: "Connect",
    title: "Open the database you need.",
    body: "Save a connection, or connect at server level and choose from every database your account can access.",
    meta: "PostgreSQL · MySQL / MariaDB · SQLite · Turso · D1",
  },
  {
    id: "browse",
    step: "02",
    label: "See data",
    title: "Get to the useful rows quickly.",
    body: "Write with instant local SQL and schema suggestions, browse tables, search objects, filter and sort results, inspect full cells, and keep recent SQL close.",
    meta: "Context-aware · No per-keystroke database calls",
  },
  {
    id: "follow",
    step: "03",
    label: "Follow records",
    title: "Move across tables without losing the trail.",
    body: "Follow declared primary and foreign keys in either direction, then step back through your navigation history.",
    meta: "Composite keys included",
  },
  {
    id: "compare",
    step: "04",
    label: "See changes",
    title: "Ask what changed after this point.",
    body: "Create a named Change Profiler anchor, run the process you care about, then review exact row, column, table, and schema differences.",
    meta: "Local baseline · No database triggers",
  },
  {
    id: "backup",
    step: "05",
    label: "Back up",
    title: "Publish a verified backup safely.",
    body: "Back up local or reachable remote databases to an absolute local folder or OS-mounted volume, manually or on a schedule.",
    meta: "Local sources · Remote sources · Local/mounted destinations",
  },
];

const engines = ["PostgreSQL", "MySQL / MariaDB", "SQLite", "Turso / LibSQL", "Cloudflare D1"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "dbterm features",
  description,
  url: "https://dbterm.shreyam1008.com.np/features/",
  mainEntity: {
    "@type": "SoftwareApplication",
    name: "dbterm",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS, Windows",
    featureList: features.map((feature) => `${feature.label}: ${feature.body}`),
  },
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="features-page">
    <section class="features-hero" aria-labelledby="features-title">
      <div class="site-container features-hero-grid">
        <div>
          <h1 id="features-title">Connect. See. Follow.<br /><span>Compare. Back up.</span></h1>
        </div>
        <div class="features-hero-copy">
          <p>Open the database, find the row, follow its relationships, see what changed, and protect it—without leaving the terminal.</p>
          <div class="features-actions">
            <a class="button primary" href={withBase('/#install')}>Install dbterm</a>
            <a class="button outline" href="#quick-tour">Take the quick tour</a>
          </div>
        </div>
      </div>
    </section>

    <section class="feature-tour" id="quick-tour" aria-labelledby="tour-title" data-feature-explorer>
      <div class="site-container">
        <header class="section-heading">
          <h2 id="tour-title">Your everyday database loop.</h2>
          <p>Choose a job. See how dbterm keeps it close.</p>
        </header>

        <div class="feature-console">
          <div class="feature-tabs" role="tablist" aria-label="dbterm features">
            {features.map((feature, index) => (
              <button
                type="button"
                role="tab"
                id={`feature-tab-${feature.id}`}
                aria-controls={`feature-panel-${feature.id}`}
                aria-selected={index === 1 ? "true" : "false"}
                tabindex={index === 1 ? 0 : -1}
                data-feature-button={feature.id}
              >
                <span class="feature-step">{feature.step}</span>
                <span>{feature.label}</span>
                <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M5 10h10m-4-4 4 4-4 4" /></svg>
              </button>
            ))}
          </div>

          <div class="feature-stage">
            {features.map((feature, index) => (
              <article
                class="feature-panel"
                id={`feature-panel-${feature.id}`}
                role="tabpanel"
                aria-labelledby={`feature-tab-${feature.id}`}
                hidden={index !== 1}
                data-feature-panel={feature.id}
              >
                <div class="panel-copy">
                  <p class="panel-meta">{feature.meta}</p>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </div>

                {feature.id === "browse" && (
                  <figure class="screen-frame">
                    <img
                      src={withBase('/main_ui.png')}
                      alt="dbterm query workspace showing connections, tables, SQL, and typed query results"
                      width="1916"
                      height="933"
                      loading="eager"
                      decoding="async"
                    />
                    <figcaption>Actual dbterm workspace</figcaption>
                  </figure>
                )}

                {feature.id === "backup" && (
                  <figure class="screen-frame screen-frame-backup">
                    <img
                      src={withBase('/assets/2.png')}
                      alt="dbterm backup form with source, destination, and format controls"
                      width="1222"
                      height="456"
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>Actual one-off backup flow</figcaption>
                  </figure>
                )}

                {feature.id === "connect" && (
                  <div class="terminal-card" aria-label="Example database connection browser">
                    <div class="terminal-bar"><span></span><span></span><span></span><small>dbterm / connect</small></div>
                    <div class="connection-scene">
                      <div class="connection-node active"><span>saved</span><strong>Local PostgreSQL</strong><small>localhost:5432</small></div>
                      <div class="connection-line" aria-hidden="true"></div>
                      <div class="database-list">
                        <p><span>●</span> inventory</p>
                        <p><span>○</span> analytics</p>
                        <p><span>○</span> postgres</p>
                      </div>
                    </div>
                    <p class="terminal-status"><kbd>Enter</kbd> open database <span>3 available</span></p>
                  </div>
                )}

                {feature.id === "follow" && (
                  <div class="terminal-card" aria-label="Example relationship navigation in dbterm">
                    <div class="terminal-bar"><span></span><span></span><span></span><small>dbterm / relationships</small></div>
                    <div class="record-path">
                      <div><small>customers</small><strong>#144</strong><span>maya@example.com</span></div>
                      <svg aria-hidden="true" viewBox="0 0 56 20"><path d="M2 10h48m-7-7 7 7-7 7" /></svg>
                      <div><small>orders</small><strong>#825</strong><span>customer_id 144</span></div>
                      <svg aria-hidden="true" viewBox="0 0 56 20"><path d="M2 10h48m-7-7 7 7-7 7" /></svg>
                      <div><small>payments</small><strong>#17503</strong><span>order_id 825</span></div>
                    </div>
                    <p class="terminal-status"><kbd>←</kbd> back <span>2 relationships followed</span></p>
                  </div>
                )}

                {feature.id === "compare" && (
                  <div class="terminal-card" aria-label="Example Change Profiler result">
                    <div class="terminal-bar"><span></span><span></span><span></span><small>Change Profiler / before-import</small></div>
                    <div class="diff-scene">
                      <div class="diff-summary"><span class="added"><b>+</b> inserted</span><span class="updated"><b>~</b> updated</span><span class="removed"><b>−</b> deleted</span><span><b>Δ</b> schema</span></div>
                      <div class="diff-row"><code>orders / #825</code><span class="old">status: pending</span><svg aria-hidden="true" viewBox="0 0 30 12"><path d="M1 6h26m-4-4 4 4-4 4" /></svg><span class="new">status: paid</span></div>
                      <div class="diff-row"><code>payments / #17503</code><span class="new wide">new row</span></div>
                    </div>
                    <p class="terminal-status"><kbd>Enter</kbd> inspect change <span>baseline removed after report</span></p>
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="engine-section" aria-labelledby="engines-title">
      <div class="site-container engine-layout">
        <div>
          <h2 id="engines-title">All the databases.<br />One workflow.</h2>
          <p>Use the same keyboard-first flow across local files, database servers, and cloud databases.</p>
          <div class="engine-list" aria-label="Supported databases">
            {engines.map((engine) => <span>{engine}</span>)}
          </div>
        </div>
        <div class="backup-routes" aria-label="Supported backup routes">
          <div><strong>Local</strong><svg aria-hidden="true" viewBox="0 0 70 18"><path d="M2 9h64m-6-6 6 6-6 6" /></svg><strong>Local</strong></div>
          <div><strong>Local</strong><svg aria-hidden="true" viewBox="0 0 70 18"><path d="M2 9h64m-6-6 6 6-6 6" /></svg><strong>Remote</strong></div>
          <div><strong>Remote</strong><svg aria-hidden="true" viewBox="0 0 70 18"><path d="M2 9h64m-6-6 6 6-6 6" /></svg><strong>Local</strong></div>
          <div><strong>Remote</strong><svg aria-hidden="true" viewBox="0 0 70 18"><path d="M2 9h64m-6-6 6 6-6 6" /></svg><strong>Remote</strong></div>
          <a href={withBase('/backup/')}>Explore Backup Center <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="feature-proof" aria-label="dbterm product principles">
      <div class="site-container proof-grid">
        <article><span>01</span><h2>Private by default</h2><p>Connections, history, baselines, and backup state stay on your machine.</p></article>
        <article><span>02</span><h2>No hosted control plane</h2><p>dbterm connects directly from your computer to your databases.</p></article>
        <article><span>03</span><h2>Open source</h2><p>Read the code, report a bug, or shape what comes next.</p></article>
      </div>
    </section>

    <section class="features-cta">
      <div class="site-container">
        <p>Your everyday database loop, in one terminal.</p>
        <div>
          <a class="button primary" href={withBase('/#install')}>Install dbterm</a>
          <a class="button outline" href={withBase('/guide/')}>Read the guide</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const initializedExplorers = new WeakSet<HTMLElement>();

  function initializeFeatureExplorer(root: HTMLElement) {
    if (initializedExplorers.has(root)) return;
    initializedExplorers.add(root);

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-feature-button]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-feature-panel]"));

    function activate(id: string, focus = false) {
      buttons.forEach((button) => {
        const selected = button.dataset.featureButton === id;
        button.setAttribute("aria-selected", String(selected));
        button.tabIndex = selected ? 0 : -1;
        if (selected && focus) button.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.featurePanel !== id;
      });
    }

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => activate(button.dataset.featureButton ?? ""));
      button.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowDown" || event.key === "ArrowRight") next = index + 1;
        else if (event.key === "ArrowUp" || event.key === "ArrowLeft") next = index - 1;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = buttons.length - 1;
        else return;
        event.preventDefault();
        const target = buttons[(next + buttons.length) % buttons.length];
        activate(target.dataset.featureButton ?? "", true);
      });
    });
  }

  function initializeFeatureExplorers() {
    document.querySelectorAll<HTMLElement>("[data-feature-explorer]").forEach(initializeFeatureExplorer);
  }

  initializeFeatureExplorers();
  document.addEventListener("astro:page-load", initializeFeatureExplorers);
</script>

<style>
  .features-hero {
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
    background-image: linear-gradient(to right, color-mix(in srgb, var(--line) 35%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in srgb, var(--line) 35%, transparent) 1px, transparent 1px);
    background-size: 54px 54px;
  }
  .features-hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); align-items: end; gap: clamp(2rem, 7vw, 7rem); }
  .features-hero h1 { max-width: 12ch; margin: 0; font-size: clamp(3.35rem, 7.2vw, 7rem); line-height: .88; letter-spacing: -.075em; }
  .features-hero h1 span { color: var(--brand-strong); }
  .features-hero-copy { padding-bottom: .4rem; }
  .features-hero-copy > p { max-width: 31rem; margin: 0; color: var(--ink-soft); font-size: clamp(1.05rem, 1.45vw, 1.28rem); line-height: 1.65; }
  .features-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }

  .feature-tour { padding: clamp(4.5rem, 8vw, 7.5rem) 0; scroll-margin-top: 4rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .section-heading h2, .engine-layout h2 { max-width: 13ch; margin: 0; font-size: clamp(2.55rem, 5vw, 5rem); line-height: .95; letter-spacing: -.06em; }
  .section-heading p { margin: 0 0 .4rem; color: var(--ink-soft); }
  .feature-console { display: grid; grid-template-columns: 15rem minmax(0, 1fr); overflow: hidden; min-height: 650px; border: 1px solid var(--line); border-radius: 1.25rem; background: var(--surface); box-shadow: 0 28px 90px rgb(17 43 36 / .1); }
  .feature-tabs { display: flex; flex-direction: column; padding: .85rem; border-right: 1px solid var(--line); background: var(--brand-pale); }
  .feature-tabs button { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: .65rem; width: 100%; padding: 1rem .8rem; border: 0; border-radius: .7rem; background: transparent; color: var(--ink-soft); text-align: left; cursor: pointer; font: inherit; font-weight: 700; }
  .feature-tabs button svg { fill: none; stroke: currentColor; stroke-width: 1.7; opacity: 0; transform: translateX(-5px); transition: opacity .18s ease, transform .18s ease; }
  .feature-tabs button:hover { color: var(--ink); background: color-mix(in srgb, var(--surface) 55%, transparent); }
  .feature-tabs button[aria-selected="true"] { color: var(--surface); background: var(--brand-strong); }
  .feature-tabs button[aria-selected="true"] svg { opacity: 1; transform: translateX(0); }
  .feature-step { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .66rem; letter-spacing: .06em; opacity: .65; }
  .feature-stage { min-width: 0; }
  .feature-panel { height: 100%; padding: clamp(1.5rem, 3vw, 2.75rem); }
  .feature-panel[hidden] { display: none; }
  .panel-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr); gap: 1rem 3rem; align-items: end; margin-bottom: 1.5rem; }
  .panel-meta { grid-column: 1 / -1; margin: 0; color: var(--brand-strong); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .68rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .panel-copy h3 { margin: 0; max-width: 18ch; font-size: clamp(2rem, 3.5vw, 3.5rem); line-height: .98; letter-spacing: -.055em; }
  .panel-copy > p:last-child { margin: 0; color: var(--ink-soft); line-height: 1.65; }
  .screen-frame, .terminal-card { position: relative; overflow: hidden; min-height: 390px; margin: 0; border: 1px solid rgb(255 255 255 / .12); border-radius: .9rem; background: #111b27; box-shadow: 0 22px 50px rgb(17 43 36 / .2); }
  .screen-frame { display: flex; align-items: center; }
  .screen-frame img { display: block; width: 100%; height: auto; }
  .screen-frame figcaption { position: absolute; right: .8rem; bottom: .8rem; padding: .45rem .65rem; border: 1px solid rgb(255 255 255 / .15); border-radius: .45rem; background: rgb(10 18 27 / .82); color: #d7e0e9; font-size: .72rem; backdrop-filter: blur(10px); }
  .screen-frame-backup img { padding: 1rem; }
  .terminal-card { display: grid; grid-template-rows: auto 1fr auto; color: #d7e0e9; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .terminal-bar { display: flex; align-items: center; gap: .4rem; min-height: 2.7rem; padding: 0 1rem; border-bottom: 1px solid rgb(255 255 255 / .1); background: #0b131d; }
  .terminal-bar > span { width: .58rem; height: .58rem; border-radius: 999px; background: #ff7a65; }
  .terminal-bar > span:nth-child(2) { background: #e8c35a; }
  .terminal-bar > span:nth-child(3) { background: #78c69a; }
  .terminal-bar small { margin-left: .45rem; color: #8493a4; }
  .terminal-status { display: flex; align-items: center; gap: .5rem; margin: 0; padding: .8rem 1rem; border-top: 1px solid rgb(255 255 255 / .1); color: #9babbc; font-size: .72rem; }
  .terminal-status kbd { border: 1px solid #4b5d70; border-bottom-width: 2px; border-radius: .25rem; padding: .12rem .35rem; background: #1d2b3a; color: #d7e0e9; }
  .terminal-status span { margin-left: auto; color: #72d1a1; }
  .connection-scene { display: grid; grid-template-columns: minmax(190px, .8fr) 6rem minmax(220px, 1fr); align-items: center; padding: 3rem clamp(1.25rem, 5vw, 5rem); }
  .connection-node, .database-list { border: 1px solid #35485b; border-radius: .65rem; background: #162434; }
  .connection-node { display: grid; gap: .25rem; padding: 1.15rem; }
  .connection-node span { width: max-content; padding: .12rem .4rem; border-radius: .25rem; background: #254c3c; color: #72d1a1; font-size: .65rem; text-transform: uppercase; }
  .connection-node small { color: #8493a4; }
  .connection-line { height: 1px; background: #496174; }
  .database-list { overflow: hidden; }
  .database-list p { display: flex; gap: .7rem; margin: 0; padding: .8rem 1rem; border-bottom: 1px solid #2a3b4d; color: #aebbc9; }
  .database-list p:first-child { background: #20384b; color: #fff; }
  .database-list p:last-child { border: 0; }
  .database-list span { color: #72d1a1; }
  .record-path { display: grid; grid-template-columns: 1fr 3.5rem 1fr 3.5rem 1fr; align-items: center; padding: 3rem 2rem; }
  .record-path > div { display: grid; gap: .55rem; min-width: 0; padding: 1.15rem; border: 1px solid #35485b; border-radius: .65rem; background: #162434; }
  .record-path small { color: #72d1a1; }
  .record-path strong { font-size: 1.35rem; color: #fff; }
  .record-path span { overflow: hidden; color: #8493a4; font-size: .72rem; text-overflow: ellipsis; }
  .record-path svg, .backup-routes svg, .diff-row svg { width: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; color: #60758a; }
  .diff-scene { display: grid; align-content: center; gap: 1rem; padding: 2rem clamp(1.25rem, 4vw, 3.5rem); }
  .diff-summary { display: grid; grid-template-columns: repeat(4, 1fr); overflow: hidden; border: 1px solid #35485b; border-radius: .65rem; }
  .diff-summary span { display: flex; align-items: center; gap: .55rem; padding: 1rem; border-right: 1px solid #35485b; color: #9babbc; font-size: .72rem; }
  .diff-summary span:last-child { border: 0; }
  .diff-summary b { font-size: 1.2rem; color: #d7e0e9; }
  .diff-summary .added b, .diff-row .new { color: #72d1a1; }
  .diff-summary .updated b { color: #e8c35a; }
  .diff-summary .removed b, .diff-row .old { color: #ff8977; }
  .diff-row { display: grid; grid-template-columns: minmax(140px, 1fr) minmax(130px, 1fr) 2rem minmax(130px, 1fr); align-items: center; gap: .75rem; padding: .9rem 1rem; border: 1px solid #2a3b4d; border-radius: .5rem; background: #142131; font-size: .76rem; }
  .diff-row code { color: #d7e0e9; }
  .diff-row .wide { grid-column: 2 / -1; }
  .engine-section { padding: clamp(4.5rem, 8vw, 7.5rem) 0; border-block: 1px solid var(--line); background: var(--brand-pale); }
  .engine-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .75fr); align-items: center; gap: clamp(3rem, 9vw, 9rem); }
  .engine-layout > div > p { max-width: 36rem; color: var(--ink-soft); line-height: 1.65; }
  .engine-list { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.75rem; }
  .engine-list span { padding: .5rem .7rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink-soft); font-size: .75rem; font-weight: 700; }
  .backup-routes { overflow: hidden; border: 1px solid color-mix(in srgb, var(--brand-strong) 45%, transparent); border-radius: 1rem; background: var(--brand-strong); color: #eaf7f0; box-shadow: 0 24px 60px rgb(17 43 36 / .18); }
  .backup-routes > div { display: grid; grid-template-columns: 1fr 4.5rem 1fr; align-items: center; gap: .75rem; padding: 1rem 1.25rem; border-bottom: 1px solid rgb(255 255 255 / .14); }
  .backup-routes strong { font-size: .82rem; }
  .backup-routes svg { color: #9bdbb9; }
  .backup-routes a { display: flex; justify-content: space-between; padding: 1rem 1.25rem; color: #fff; font-size: .78rem; font-weight: 800; text-decoration: none; }
  .backup-routes a:hover { background: rgb(255 255 255 / .08); }
  .feature-proof { border-bottom: 1px solid var(--line); }
  .proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .proof-grid article { padding: 2.5rem clamp(1rem, 3vw, 2.5rem); border-right: 1px solid var(--line); }
  .proof-grid article:last-child { border: 0; }
  .proof-grid span { color: var(--brand-strong); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .66rem; font-weight: 700; }
  .proof-grid h2 { margin: 1.8rem 0 .5rem; font-size: 1.3rem; letter-spacing: -.03em; }
  .proof-grid p { margin: 0; color: var(--ink-soft); font-size: .88rem; line-height: 1.6; }
  .features-cta { padding: clamp(4rem, 7vw, 6.5rem) 0; }
  .features-cta .site-container { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .features-cta p { max-width: 18ch; margin: 0; font-size: clamp(2rem, 4vw, 4rem); font-weight: 800; line-height: 1; letter-spacing: -.055em; }
  .features-cta .site-container > div { display: flex; flex-wrap: wrap; gap: .75rem; }

  @media (max-width: 900px) {
    .features-hero-grid, .engine-layout { grid-template-columns: 1fr; }
    .features-hero-copy { max-width: 38rem; }
    .feature-console { grid-template-columns: 1fr; min-height: 0; }
    .feature-tabs { flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line); scrollbar-width: thin; }
    .feature-tabs button { min-width: 10rem; }
    .feature-tabs button svg { display: none; }
    .panel-copy { grid-template-columns: 1fr; }
    .screen-frame, .terminal-card { min-height: 340px; }
    .proof-grid { grid-template-columns: 1fr; }
