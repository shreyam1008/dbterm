---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "dbterm vs DBeaver, MySQL Workbench & pgAdmin (2026)";
const description =
  "Compare dbterm with DBeaver, MySQL Workbench, and pgAdmin for database coverage, terminal vs GUI workflows, relationship navigation, and backup and restore.";

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  const trimmedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  const trimmedPath = path.startsWith("/") ? path.slice(1) : path;
  return `${trimmedBase}/${trimmedPath}`.replace(/\/{2,}/g, "/");
};

const products = ["dbterm", "DBeaver", "MySQL Workbench", "pgAdmin"];
const comparisonRows = [
  ["Interface", "Terminal TUI", "Desktop GUI", "Desktop GUI", "Desktop / web GUI"],
  ["Database scope", "PostgreSQL, MySQL / MariaDB, SQLite, Turso, D1", "Broad driver catalogue", "MySQL", "PostgreSQL"],
  ["Everyday data", "Browse, query, filter, follow keys", "Browse, query, edit, transfer", "Browse, query, model", "Browse, query, administer"],
  ["Relationships", "Follow records both ways", "Visual ER diagrams", "EER modeling", "ERD and schema diff"],
  ["Backup & restore", "Scheduled local / remote jobs", "Native database tools", "MySQL export / import", "PostgreSQL backup / restore"],
  ["Best fit", "Daily terminal work + owned backups", "Broad visual workbench", "MySQL development and admin", "PostgreSQL administration"],
];

const terminalAlternatives = [
  { name: "Harlequin", summary: "SQL editor first", note: "A polished terminal SQL IDE with an adapter ecosystem.", href: "https://harlequin.sh/" },
  { name: "rainfrog", summary: "Vim-style exploration", note: "Fast keyboard navigation with explicit database support tiers.", href: "https://github.com/achristmascarl/rainfrog" },
  { name: "LazySQL", summary: "Connections and editing", note: "Multiple connections, tabs, row editing, and query history.", href: "https://github.com/jorgerojas26/lazysql" },
];

const sources = [
  ["dbterm README", "https://github.com/shreyam1008/dbterm#readme"],
  ["DBeaver database drivers", "https://dbeaver.com/docs/dbeaver/Database-drivers/"],
  ["DBeaver backup and restore", "https://dbeaver.com/docs/dbeaver/Backup-Restore/"],
  ["DBeaver data transfer", "https://dbeaver.com/docs/dbeaver/Data-transfer/"],
  ["DBeaver ER diagrams", "https://dbeaver.com/docs/dbeaver/ER-Diagrams/"],
  ["MySQL Workbench manual", "https://dev.mysql.com/doc/workbench/en/"],
  ["MySQL Workbench export and import", "https://dev.mysql.com/doc/workbench/en/wb-admin-export-import.html"],
  ["pgAdmin documentation", "https://www.pgadmin.org/docs/pgadmin4/latest/"],
  ["pgAdmin backup and restore", "https://www.pgadmin.org/docs/pgadmin4/latest/backup_and_restore.html"],
  ["Harlequin adapters", "https://harlequin.sh/docs/adapters"],
  ["rainfrog README", "https://github.com/achristmascarl/rainfrog#readme"],
  ["LazySQL README", "https://github.com/jorgerojas26/lazysql#readme"],
];

const canonicalUrl = "https://dbterm.shreyam1008.com.np/compare/";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: "2026-08-04",
  dateModified: "2026-08-16",
  mainEntityOfPage: canonicalUrl,
  author: { "@type": "Person", name: "Shreyam Adhikari", url: "https://shreyam1008.com.np/" },
  about: products.map((name) => ({ "@type": "SoftwareApplication", name, applicationCategory: "DeveloperApplication" })),
  citation: sources.map(([, href]) => href),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is dbterm a DBeaver alternative?",
      acceptedAnswer: { "@type": "Answer", text: "dbterm is a lightweight terminal alternative for everyday browsing, queries, relationship navigation, and scheduled backups. DBeaver is the stronger fit when you need a broad visual workbench, ER diagrams, or data transfer tools." },
    },
    {
      "@type": "Question",
      name: "How does dbterm compare with MySQL Workbench?",
      acceptedAnswer: { "@type": "Answer", text: "MySQL Workbench focuses on visual MySQL development, modeling, and administration. dbterm supports MySQL and MariaDB alongside PostgreSQL, SQLite, Turso, and Cloudflare D1 in a terminal-first workflow." },
    },
    {
      "@type": "Question",
      name: "How does dbterm compare with pgAdmin?",
      acceptedAnswer: { "@type": "Answer", text: "pgAdmin is a visual PostgreSQL administration and development tool. dbterm is a smaller terminal tool for daily work across five database targets, including PostgreSQL." },
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={[articleJsonLd, faqJsonLd]}>
  <div class="compare-page">
    <section class="compare-hero" aria-labelledby="compare-title">
      <div class="site-container hero-inner">
        <h1 id="compare-title">dbterm vs DBeaver,<br /><span>MySQL Workbench &amp; pgAdmin</span></h1>
        <p>One small terminal tool for everyday data work and backups across five database targets.</p>
        <div class="hero-actions">
          <a class="button primary" href="#comparison">See the comparison</a>
          <a class="button outline" href={withBase('/#install')}>Install dbterm</a>
        </div>
      </div>
    </section>

    <section class="comparison-section" id="comparison" aria-labelledby="comparison-title">
      <div class="site-container">
        <div class="section-heading">
          <h2 id="comparison-title">The useful differences.</h2>
          <p>Four tools. Six decisions. No scorecard theatre.</p>
        </div>
        <div class="table-shell" tabindex="0" aria-label="Scrollable database tool comparison">
          <table>
            <caption class="sr-only">dbterm compared with DBeaver, MySQL Workbench, and pgAdmin</caption>
            <thead><tr><th scope="col">Compare</th>{products.map((product, index) => <th scope="col" class:list={{ featured: index === 0 }}>{product}</th>)}</tr></thead>
            <tbody>
              {comparisonRows.map(([label, ...values]) => (
                <tr><th scope="row">{label}</th>{values.map((value, index) => <td class:list={{ featured: index === 0 }}>{value}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="review-note">Reviewed 16 August 2026 against official product documentation.</p>
      </div>
    </section>

    <section class="decision-section" aria-labelledby="decision-title">
      <div class="site-container">
        <h2 id="decision-title" class="sr-only">Which database tool should you choose?</h2>
        <div class="decision-grid">
          <article>
            <h3>Choose dbterm when</h3>
            <ul><li>You want one terminal binary.</li><li>You work across its five supported database targets.</li><li>You want scheduled local or remote backups.</li></ul>
          </article>
          <article>
            <h3>Choose a desktop tool when</h3>
            <ul><li>You need visual modeling or diagrams.</li><li>You need deep database-specific administration.</li><li>You prefer broad GUI workflows.</li></ul>
          </article>
        </div>
      </div>
    </section>

    <section class="alternatives-section" aria-labelledby="alternatives-title">
      <div class="site-container">
        <div class="section-heading compact">
          <h2 id="alternatives-title">Three terminal alternatives worth knowing.</h2>
          <p>Good tools with a different centre of gravity.</p>
        </div>
        <div class="alternative-list">
          {terminalAlternatives.map((tool) => (
            <a href={tool.href} target="_blank" rel="noreferrer">
              <strong>{tool.name}</strong><span>{tool.summary}</span><small>{tool.note}</small>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          ))}
        </div>
        <details class="sources">
          <summary>Sources and review notes</summary>
          <div class="source-body">
            <p>This is a fit comparison, not a universal ranking. Product scope and terminology come from the official sources below; dbterm claims come from its current documentation and release.</p>
            <ul>{sources.map(([name, href]) => <li><a href={href} target="_blank" rel="noreferrer">{name}</a></li>)}</ul>
            <p>See something outdated? <a href="https://github.com/shreyam1008/dbterm/issues/new?title=Comparison%20page%20correction" target="_blank" rel="noreferrer">Report a correction</a>.</p>
          </div>
        </details>
      </div>
    </section>

    <section class="compare-cta" aria-labelledby="cta-title">
      <div class="site-container cta-inner">
        <h2 id="cta-title">Use the tool that fits the job.</h2>
        <div><a class="button light" href={withBase('/#install')}>Install dbterm</a><a class="button ghost" href={withBase('/guide/')}>Read the guide</a></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .compare-page {
    --compare-green: #0b5138;
    --compare-green-dark: #073727;
    --compare-line: color-mix(in srgb, var(--line) 82%, transparent);
    background-image: linear-gradient(color-mix(in srgb, var(--line) 20%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--line) 20%, transparent) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center top;
  }
  .compare-hero { padding: clamp(4.5rem, 10vw, 8.5rem) 0 clamp(3.5rem, 7vw, 6rem); text-align: center; }
  .hero-inner { max-width: 1180px; }
  .compare-hero h1 { margin: 0 auto; max-width: 1100px; color: var(--ink); font-size: clamp(2.7rem, 6.4vw, 6rem); line-height: .96; letter-spacing: -.065em; }
  .compare-hero h1 span { color: var(--compare-green); }
  .compare-hero p { max-width: 790px; margin: 1.75rem auto 0; color: var(--ink-soft); font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.55; }
  .hero-actions { display: flex; justify-content: center; gap: .8rem; margin-top: 2rem; }
  .hero-actions .button { min-width: 180px; }
  .comparison-section, .alternatives-section { padding: clamp(2.5rem, 6vw, 5rem) 0; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .section-heading h2, .decision-grid h3, .compare-cta h2 { margin: 0; color: var(--ink); font-size: clamp(1.8rem, 3.5vw, 3rem); line-height: 1.05; letter-spacing: -.045em; }
  .section-heading p { margin: 0; color: var(--ink-soft); font-size: .95rem; }
  .table-shell { overflow-x: auto; border: 1px solid var(--compare-line); border-radius: 18px; background: color-mix(in srgb, var(--surface) 94%, transparent); box-shadow: 0 20px 60px color-mix(in srgb, var(--ink) 8%, transparent); }
  table { width: 100%; min-width: 900px; border-collapse: collapse; table-layout: fixed; }
  th, td { padding: 1.05rem 1rem; border-right: 1px solid var(--compare-line); border-bottom: 1px solid var(--compare-line); text-align: left; vertical-align: middle; line-height: 1.35; }
  th:last-child, td:last-child { border-right: 0; }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { color: var(--ink); font-size: 1rem; font-weight: 750; }
  thead th:first-child, tbody th { width: 16%; color: var(--ink-soft); font-size: .8rem; font-weight: 750; letter-spacing: .04em; text-transform: uppercase; }
  td { color: var(--ink-soft); font-size: .9rem; }
  .featured { background: var(--compare-green); color: #f6f4ea !important; border-color: rgba(255, 255, 255, .16); }
  thead .featured { font-size: 1.15rem; }
  .review-note { margin: .9rem 0 0; color: var(--ink-faint); font-family: var(--font-mono); font-size: .72rem; }
  .decision-section { padding: clamp(3rem, 7vw, 6rem) 0; }
  .decision-grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--compare-line); border-radius: 18px; background: color-mix(in srgb, var(--surface) 94%, transparent); overflow: hidden; }
  .decision-grid article { padding: clamp(1.75rem, 4vw, 3.5rem); }
  .decision-grid article + article { border-left: 1px solid var(--compare-line); }
  .decision-grid h3 { color: var(--compare-green); font-size: clamp(1.55rem, 3vw, 2.55rem); }
  .decision-grid ul { display: grid; gap: .85rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .decision-grid li { position: relative; padding-left: 1.25rem; color: var(--ink-soft); font-size: 1rem; }
  .decision-grid li::before { content: ""; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .alternative-list { border: 1px solid var(--compare-line); border-radius: 16px; background: color-mix(in srgb, var(--surface) 94%, transparent); overflow: hidden; }
  .alternative-list a { display: grid; grid-template-columns: minmax(120px, .8fr) minmax(160px, 1fr) minmax(280px, 2fr) 28px; align-items: center; gap: 1rem; padding: 1.15rem 1.35rem; color: var(--ink); text-decoration: none; }
  .alternative-list a + a { border-top: 1px solid var(--compare-line); }
  .alternative-list a:hover { background: var(--brand-soft); }
  .alternative-list strong { color: var(--compare-green); }
  .alternative-list span { color: var(--ink-soft); }
  .alternative-list small { color: var(--ink-faint); }
  .alternative-list svg { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sources { margin-top: 1.25rem; border: 1px solid var(--compare-line); border-radius: 14px; background: color-mix(in srgb, var(--surface) 94%, transparent); }
  .sources summary { padding: 1.15rem 1.35rem; color: var(--ink); font-weight: 700; cursor: pointer; }
  .source-body { padding: 0 1.35rem 1.35rem; color: var(--ink-soft); font-size: .88rem; }
  .source-body p { max-width: 850px; }
  .source-body ul { columns: 2; gap: 2rem; padding-left: 1.15rem; }
  .source-body li { margin: .4rem 0; break-inside: avoid; }
  .compare-cta { padding: clamp(2rem, 5vw, 4rem) 0 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.75rem, 4vw, 3rem); border-radius: 18px; background: linear-gradient(125deg, var(--compare-green-dark), var(--compare-green)); }
  .compare-cta h2 { color: #f6f4ea; }
  .cta-inner > div { display: flex; gap: .75rem; }
  .button.light { background: #f6f4ea; color: var(--compare-green-dark); }
  .button.ghost { border: 1px solid rgba(255, 255, 255, .6); color: #fff; background: transparent; }
  .button.ghost:hover { background: rgba(255, 255, 255, .1); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 820px) {
    .compare-hero h1 br { display: none; }
    .section-heading { display: block; }
    .section-heading p { margin-top: .6rem; }
    .decision-grid { grid-template-columns: 1fr; }
    .decision-grid article + article { border-top: 1px solid var(--compare-line); border-left: 0; }
    .alternative-list a { grid-template-columns: 1fr auto; gap: .35rem 1rem; }
    .alternative-list span, .alternative-list small { grid-column: 1; }
    .alternative-list svg { grid-column: 2; grid-row: 1 / 4; }
    .cta-inner { display: block; }
    .cta-inner > div { margin-top: 1.5rem; }
  }
  @media (max-width: 560px) {
    .compare-hero { padding-top: 3.75rem; }
    .compare-hero h1 { font-size: clamp(2.35rem, 12vw, 3.8rem); }
    .hero-actions, .cta-inner > div { flex-direction: column; }
    .hero-actions .button { width: 100%; }
    .table-shell { margin-right: -1rem; border-radius: 14px 0 0 14px; }
    .table-shell::after { content: "Swipe to compare →"; position: sticky; left: 1rem; display: block; width: max-content; padding: .65rem 0; color: var(--ink-faint); font-family: var(--font-mono); font-size: .7rem; }
    .source-body ul { columns: 1; }
  }
</style>
