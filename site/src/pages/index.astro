---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "dbterm — Fast, Keyboard-First Terminal Database Client";
const description =
  "Explore schemas, run SQL, follow foreign keys, filter results, and export data from one fast terminal UI for PostgreSQL, MySQL, SQLite, Turso, and Cloudflare D1.";
const keywords =
  "dbterm, terminal database client, terminal sql client, postgres tui, mysql tui, sqlite tui, turso, cloudflare d1";

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  const trimmedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  const trimmedPath = path.startsWith("/") ? path.slice(1) : path;
  return `${trimmedBase}/${trimmedPath}`.replace(/\/{2,}/g, "/");
};

const installUnix =
  "curl -fsSL https://raw.githubusercontent.com/shreyam1008/dbterm/main/install.sh | bash";
const installWindows =
  'powershell -NoProfile -ExecutionPolicy Bypass -Command "irm https://raw.githubusercontent.com/shreyam1008/dbterm/main/install.ps1 | iex"';

const features = [
  {
    marker: "⌘",
    key: "Ctrl P",
    title: "Find anything",
    body: "Fuzzy-search every command, database object, and recent query. Matches highlight as you type, with context before you act.",
    tone: "violet"
  },
  {
    marker: "↗",
    key: "F / Backspace",
    title: "Follow the data",
    body: "Jump across declared foreign keys—including composite keys—then return to the exact table and row you came from.",
    tone: "cyan"
  },
  {
    marker: "≡",
    key: "/  C  V",
    title: "Filter in place",
    body: "Compose typed AND filters, copy a complete cell, or filter a column by the clipboard value without leaving Results.",
    tone: "lime"
  },
  {
    marker: "⇩",
    key: "Alt E",
    title: "Export what matters",
    body: "Export selected rows, the current page, or every matching row to CSV with progress, cancellation, and no silent overwrite.",
    tone: "amber"
  },
  {
    marker: "◌",
    key: "Esc / Ctrl C",
    title: "Stay responsive",
    body: "Queries, imports, exports, and refreshes show clear progress and can be cancelled without freezing the interface.",
    tone: "coral"
  },
  {
    marker: "↔",
    key: "+ / Ctrl +",
    title: "Shape the view",
    body: "Resize one column, scale the full table, change preview limits, and move between panels entirely from the keyboard.",
    tone: "blue"
  }
];

const databases = [
  { short: "PG", name: "PostgreSQL", detail: "Query · schema · backup · import", tone: "blue" },
  { short: "MY", name: "MySQL", detail: "Query · schema · backup · import", tone: "amber" },
  { short: "SQ", name: "SQLite", detail: "Local files · snapshots", tone: "cyan" },
  { short: "TU", name: "Turso", detail: "Cloud LibSQL workflows", tone: "lime" },
  { short: "D1", name: "Cloudflare D1", detail: "API-backed SQL", tone: "coral" }
];

const workflow = [
  { number: "01", title: "Connect", body: "Save local, remote, or cloud database connections once." },
  { number: "02", title: "Explore", body: "Search tables, inspect schemas, and move through relationships." },
  { number: "03", title: "Query", body: "Write SQL, use history, and inspect results without a mouse." },
  { number: "04", title: "Act", body: "Filter, copy, export, back up, or import with visible progress." }
];

const faqItems = [
  {
    question: "Is dbterm really a single binary?",
    answer: "Yes. End users do not need Go, Java, Python, or Node. Download the platform binary or use the installer and run dbterm."
  },
  {
    question: "Which operating systems are supported?",
    answer: "Release binaries are published for Linux, macOS, and Windows on AMD64 and ARM64. Debian packages are also available."
  },
  {
    question: "Can I use it with production databases?",
    answer: "Yes, with the same care as any SQL client: use least-privilege credentials and validate destructive statements outside production first."
  },
  {
    question: "Where is the full shortcut reference?",
    answer: "The Guide covers setup, every workspace panel, keybindings, service actions, backups, imports, and troubleshooting. Alt+H also opens help inside dbterm."
  }
];

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "dbterm",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  softwareVersion: "0.5.0",
  description,
  url: "https://shreyam1008.github.io/dbterm/",
  downloadUrl: "https://github.com/shreyam1008/dbterm/releases/tag/v0.5.0",
  softwareHelp: "https://shreyam1008.github.io/dbterm/guide/",
  license: "https://github.com/shreyam1008/dbterm/blob/main/LICENSE",
  image: "https://shreyam1008.github.io/dbterm/assets/command-palette.png",
  screenshot: "https://shreyam1008.github.io/dbterm/assets/command-palette.png",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  featureList: features.map((feature) => feature.title)
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer }
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage="assets/command-palette.png"
  jsonLd={[softwareJsonLd, faqJsonLd]}
>
  <section class="landing-hero">
    <div class="hero-copy">
      <a class="release-pill" href="https://github.com/shreyam1008/dbterm/releases/tag/v0.5.0">
        <span class="release-dot" aria-hidden="true"></span>
        v0.5.0 · Brahmaputra
        <span aria-hidden="true">→</span>
      </a>

      <p class="hero-kicker">Open-source terminal database client</p>
      <h1>See your database.<br /><span>Stay in the flow.</span></h1>
      <p class="hero-lede">
        Explore schemas, run SQL, follow relationships, filter results, and export data—without
        reaching for a heavyweight desktop client.
      </p>

      <div class="hero-actions">
        <a class="button primary large" href="#install">Install dbterm</a>
        <a class="button subtle large" href="https://github.com/shreyam1008/dbterm">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
          View on GitHub
        </a>
      </div>

      <ul class="hero-proof" aria-label="Product highlights">
        <li><span>01</span> Single binary</li>
        <li><span>02</span> Keyboard first</li>
        <li><span>03</span> MIT licensed</li>
      </ul>
    </div>

    <aside class="hero-console" aria-label="Quick installation preview">
      <div class="console-bar">
        <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span>~/install</span>
        <span class="console-status">ready</span>
      </div>
      <div class="console-body">
        <p class="console-comment"># Install the latest release</p>
        <div class="console-command">
          <span aria-hidden="true">$</span>
          <code id="hero-install">{installUnix}</code>
        </div>
        <button
          class="console-copy copy-button"
          type="button"
          data-copy-target="hero-install"
          data-default-label="Copy command"
        >
          Copy command
        </button>
        <div class="console-output" aria-hidden="true">
          <p><span>✓</span> Platform detected</p>
          <p><span>✓</span> dbterm v0.5.0 installed</p>
          <p><b>→</b> Run <strong>dbterm</strong> to begin<span class="cursor"></span></p>
        </div>
      </div>
    </aside>
  </section>

  <section class="product-stage" id="product">
    <div class="stage-heading">
      <div>
        <p class="section-label">Command & object palette</p>
        <h2>Everything is a few keys away.</h2>
      </div>
      <p>Search actions, tables, procedures, and recent SQL from one fuzzy command surface.</p>
    </div>

    <figure class="terminal-shot">
      <div class="terminal-titlebar">
        <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span>dbterm · workspace</span>
        <span class="live-pill"><i aria-hidden="true"></i> keyboard active</span>
      </div>
      <img
        src={withBase("assets/command-palette.png")}
        alt="dbterm command palette fuzzy-searching clear actions, tables, and procedures"
        width="1306"
        height="514"
        loading="eager"
      />
      <figcaption>
        <span><kbd>Ctrl</kbd><b>+</b><kbd>P</kbd></span>
        Search by name or intent. Highlighted matches update as you type.
      </figcaption>
    </figure>
  </section>

  <section class="database-rail" aria-labelledby="database-heading">
    <div class="rail-heading">
      <p class="section-label">One workspace</p>
      <h2 id="database-heading">Five database targets.</h2>
    </div>
    <div class="database-grid">
      {databases.map((database) => (
        <article class="database-card">
          <span class={`database-mark ${database.tone}`}>{database.short}</span>
          <div>
            <h3>{database.name}</h3>
            <p>{database.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="feature-section" id="features">
    <div class="section-heading centered">
      <p class="section-label">Built for real work</p>
      <h2>Less interface. More momentum.</h2>
      <p>Every interaction is designed to keep your hands on the keyboard and your context intact.</p>
    </div>

    <div class="landing-feature-grid">
      {features.map((feature) => (
        <article class={`landing-feature ${feature.tone}`}>
          <div class="feature-topline">
            <span class="feature-marker" aria-hidden="true">{feature.marker}</span>
            <code>{feature.key}</code>
          </div>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="workflow-section">
    <div class="workflow-copy">
      <p class="section-label">A complete data loop</p>
      <h2>From connection to answer, without context switching.</h2>
      <p>
        dbterm brings connection management, schema exploration, querying, result navigation, and
        operational tools into one coherent terminal workspace.
      </p>
      <a class="text-link" href={withBase("guide/")}>Explore the full workflow <span>→</span></a>
    </div>

    <ol class="workflow-list">
      {workflow.map((item) => (
        <li>
          <span>{item.number}</span>
          <div><h3>{item.title}</h3><p>{item.body}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="install-section" id="install">
    <div class="install-heading">
      <p class="section-label">Get started</p>
      <h2>One command. Then just <code>dbterm</code>.</h2>
      <p>No runtime stack, account, or setup wizard required.</p>
    </div>

    <div class="install-grid">
      <article class="install-card featured">
        <div class="install-card-head">
          <div><span class="platform-icon">$</span><h3>Linux / macOS</h3></div>
          <span>Recommended</span>
        </div>
        <pre><code id="install-unix">{installUnix}</code></pre>
        <button class="install-copy copy-button" type="button" data-copy-target="install-unix" data-default-label="Copy">
          Copy
        </button>
      </article>

      <article class="install-card">
        <div class="install-card-head">
          <div><span class="platform-icon">›_</span><h3>Windows</h3></div>
          <span>PowerShell</span>
        </div>
        <pre><code id="install-windows">{installWindows}</code></pre>
        <button class="install-copy copy-button" type="button" data-copy-target="install-windows" data-default-label="Copy">
          Copy
        </button>
      </article>
    </div>

    <div class="install-links">
      <a href="https://github.com/shreyam1008/dbterm/releases/tag/v0.5.0">Download binaries</a>
      <span aria-hidden="true">·</span>
      <a href={withBase("guide/")}>Read the guide</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/shreyam1008/dbterm/blob/main/README.md#build-locally">Build from source</a>
    </div>
  </section>

  <section class="faq-section" id="faq">
    <div class="faq-heading">
      <p class="section-label">Good to know</p>
      <h2>Before you connect.</h2>
      <p>Still looking for something? The <a href={withBase("guide/")}>complete guide</a> goes deeper.</p>
    </div>
    <div class="faq-list landing-faq">
      {faqItems.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}<span aria-hidden="true">+</span></summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="closing-cta">
    <div>
      <p class="section-label">Ready when you are</p>
      <h2>Your next query belongs in the terminal.</h2>
    </div>
    <div class="closing-actions">
      <a class="button primary large" href="#install">Install dbterm</a>
      <a class="button subtle large" href="https://github.com/shreyam1008/dbterm">Star on GitHub</a>
    </div>
  </section>
</BaseLayout>
