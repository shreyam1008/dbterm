---
import BaseLayout from "../layouts/BaseLayout.astro";
import InteractiveDemo from "../components/InteractiveDemo.astro";
import ShaderField from "../components/ShaderField.astro";

const title = "dbterm — Connect, Query, Operate & Back Up Databases";
const description =
  "Connect once, browse every accessible database, query and inspect data, operate local services, and back up local or cloud databases from one terminal.";
const keywords =
  "terminal database client, terminal SQL client, PostgreSQL backup scheduler, MySQL backup tool, SQLite backup, encrypted database backup, DBeaver alternative, TUI database client";

const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  const trimmedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  const trimmedPath = path.startsWith("/") ? path.slice(1) : path;
  return `${trimmedBase}/${trimmedPath}`.replace(/\/{2,}/g, "/");
};

const installUnix =
  "curl -fsSL https://raw.githubusercontent.com/shreyam1008/dbterm/main/install.sh | bash";
const installWindows =
  'powershell -NoProfile -ExecutionPolicy Bypass -Command "irm https://raw.githubusercontent.com/shreyam1008/dbterm/main/install.ps1 | iex"';

const primaryButton =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-[var(--brand-strong)] bg-[var(--brand)] px-5 py-3 text-sm font-bold text-[var(--primary-foreground)] no-underline shadow-[0_10px_30px_color-mix(in_srgb,var(--brand)_22%,transparent)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)] hover:text-[var(--primary-foreground)] focus-visible:outline-3";
const secondaryButton =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-[var(--line-strong)] bg-[var(--surface-raised)] px-5 py-3 text-sm font-bold text-[var(--ink)] no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-[var(--brand)] hover:bg-[var(--brand-pale)] hover:text-[var(--ink)]";

const features = [
  {
    index: "01",
    key: "Ctrl P",
    title: "Find anything",
    body: "Search commands, tables, objects, and recent SQL."
  },
  {
    index: "02",
    key: "F / Backspace",
    title: "Follow relationships",
    body: "Move to parent or child rows, continue across a chain, then return one step at a time."
  },
  {
    index: "03",
    key: "/ · C · V",
    title: "Work from a cell",
    body: "Copy it, filter its column, or search with the clipboard."
  },
  {
    index: "04",
    key: "Alt E",
    title: "Export the right rows",
    body: "Export selected rows, a page, or every filtered match."
  },
  {
    index: "05",
    key: "Space",
    title: "Keep tables close",
    body: "Pin frequently used tables at the top of each database."
  },
  {
    index: "06",
    key: "Alt K",
    title: "Schedule protection",
    body: "Run compressed, encrypted backups through your OS—even after dbterm closes."
  }
];

const productPillars = [
  {
    marker: "01",
    title: "Server-first connections",
    body: "Save one PostgreSQL or MySQL login without a database name. Browse everything that account can access, choose a default, or open another database with the same credentials.",
    facts: ["Optional database", "All accessible DBs", "Stable per-user profile"]
  },
  {
    marker: "02",
    title: "Complete data workspace",
    body: "Discover schema objects, run cancellable SQL, inspect typed results, build AND filters, follow relationships in both directions, pin tables, and stream exactly the rows you want to CSV.",
    facts: ["Object palette", "Typed filters", "Import + export"]
  },
  {
    marker: "03",
    title: "Local database operations",
    body: "Inspect, start, and stop MySQL or PostgreSQL services, then connect with a saved database login and browse the server without confusing sudo credentials with database credentials.",
    facts: ["Service status", "Start / stop", "Saved-login connect"]
  },
  {
    marker: "04",
    title: "Backup and recovery",
    body: "Route local or remote sources to local, mounted, or rclone storage. Verify, compress, encrypt, retain, inspect, notify, and restore through a native OS-managed agent.",
    facts: ["All 4 local/remote routes", "Native agents", "Guarded restore"]
  }
];

const engines = [
  ["PostgreSQL", "PG"],
  ["MySQL", "MY"],
  ["SQLite", "SQ"],
  ["Turso", "TU"],
  ["Cloudflare D1", "D1"]
];

const faqItems = [
  {
    question: "Is the browser demo real?",
    answer:
      "Yes. It loads SQLite compiled to WebAssembly and runs read-only SQL against an in-memory sample database. The sample data stays in your browser and is discarded when you leave."
  },
  {
    question: "Does dbterm need Go, Node, Python, or Java installed?",
    answer:
      "No. dbterm is distributed as a single release binary for Linux, macOS, and Windows. Those frontend tools build this website only; they are not runtime requirements for dbterm."
  },
  {
    question: "Why another terminal SQL client?",
    answer:
      "dbterm covers a deliberate end-to-end loop: server-first connection, database discovery, schema, query, relationship navigation, typed filtering, import/export, local services, and durable backup/recovery in one keyboard model."
  },
  {
    question: "Can dbterm back up a remote or cloud database?",
    answer:
      "Yes. A reachable PostgreSQL, MySQL, Turso, or D1 connection can back up to a local/mounted folder or a configured rclone remote. Local and remote sources can use either destination type; dbterm adds scheduling, safe publication, history, compression, age encryption, and retention."
  }
];

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "dbterm",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Database client",
  operatingSystem: "Linux, macOS, Windows",
  softwareVersion: "0.9.0",
  description,
  url: "https://dbterm.shreyam1008.com.np/",
  downloadUrl: "https://github.com/shreyam1008/dbterm/releases/tag/v0.9.0",
  softwareHelp: "https://dbterm.shreyam1008.com.np/guide/",
  codeRepository: "https://github.com/shreyam1008/dbterm",
  license: "https://github.com/shreyam1008/dbterm/blob/main/LICENSE",
  author: {
    "@type": "Person",
    name: "Shreyam Adhikari",
    alternateName: "shreyam1008",
    url: "https://shreyam1008.com.np/",
    sameAs: ["https://github.com/shreyam1008"]
  },
  maintainer: {
    "@type": "Person",
    name: "Shreyam Adhikari",
    url: "https://shreyam1008.com.np/"
  },
  image: "https://dbterm.shreyam1008.com.np/assets/command-palette.png",
  screenshot: "https://dbterm.shreyam1008.com.np/assets/command-palette.png",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  featureList: [...productPillars.map((pillar) => pillar.title), ...features.map((feature) => feature.title)]
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "dbterm",
  alternateName: "dbterm terminal SQL client",
  url: "https://dbterm.shreyam1008.com.np/",
  description,
  creator: {
    "@type": "Person",
    name: "Shreyam Adhikari",
    alternateName: "shreyam1008",
    url: "https://shreyam1008.com.np/"
  }
};

const sourceJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "dbterm",
  description,
  codeRepository: "https://github.com/shreyam1008/dbterm",
  programmingLanguage: "Go",
  runtimePlatform: "Linux, macOS, Windows",
  license: "https://github.com/shreyam1008/dbterm/blob/main/LICENSE",
  author: {
    "@type": "Person",
    name: "Shreyam Adhikari",
    alternateName: "shreyam1008",
    url: "https://shreyam1008.com.np/",
    sameAs: ["https://github.com/shreyam1008"]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer }
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage="assets/command-palette.png"
  ogImageAlt="dbterm command palette over a PostgreSQL result table"
  jsonLd={[websiteJsonLd, softwareJsonLd, sourceJsonLd, faqJsonLd]}
>
  <section class="relative isolate overflow-hidden border-b border-[var(--line)] py-16 sm:py-20 lg:py-24">
    <ShaderField />
    <div class="site-container relative z-10">
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(390px,.95fr)] lg:gap-16">
      <div>
        <a
          href="https://github.com/shreyam1008/dbterm/releases/tag/v0.9.0"
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[color-mix(in_srgb,var(--surface)_84%,transparent)] px-3 py-1.5 font-mono text-[.68rem] font-semibold tracking-wide text-[var(--brand-strong)] no-underline backdrop-blur-md hover:border-[var(--brand)]"
        >
          <span class="size-1.5 rounded-full bg-[var(--brand)] shadow-[0_0_0_4px_color-mix(in_srgb,var(--brand)_12%,transparent)]"></span>
          v0.9.0 · Chenab
          <span aria-hidden="true">↗</span>
        </a>
        <p class="mb-4 font-mono text-[.7rem] font-semibold tracking-[.15em] text-[var(--brand-strong)] uppercase">
          Open-source terminal database workbench
        </p>
        <h1 class="max-w-[11ch] text-[clamp(3.2rem,7.8vw,7rem)] leading-[.9] font-[650] tracking-[-.07em] text-[var(--ink)]">
          Connect once.<br /><span class="text-[var(--brand)]">See every database.</span>
        </h1>
        <p class="mt-6 max-w-[600px] text-[clamp(1rem,1.8vw,1.2rem)] leading-relaxed text-[var(--ink-soft)]">
          Choose a database, query and inspect its data, operate local services, and protect local or cloud sources—without leaving the keyboard.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class={primaryButton} href="#playground">Try the real workflow <span aria-hidden="true">↓</span></a>
          <a class={secondaryButton} href="https://github.com/shreyam1008/dbterm" aria-label="View dbterm source on GitHub">
            <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"></path></svg>
            GitHub
          </a>
        </div>
        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 p-0 font-mono text-[.68rem] text-[var(--ink-faint)]" aria-label="Product facts">
          <li class="list-none">Server-first logins</li>
          <li class="list-none">Five engines</li>
          <li class="list-none">Native backup agent</li>
        </ul>
      </div>

      <aside id="install" class="relative overflow-hidden rounded-2xl border border-[var(--line-strong)] bg-[#11111b] p-5 text-[#cdd6f4] shadow-[var(--shadow-lg)] sm:p-6" aria-labelledby="install-title">
        <div class="mb-5 flex items-center justify-between gap-4">
          <div>
            <p class="mb-1 font-mono text-[.62rem] tracking-[.13em] text-[#a6e3a1] uppercase">Install</p>
            <h2 id="install-title" class="mb-0 text-xl tracking-[-.035em] text-white">One command, then <code class="text-[#a6e3a1]">dbterm</code>.</h2>
          </div>
          <span class="rounded border border-[#45475a] px-2 py-1 font-mono text-[.62rem] text-[#a6adc8]">v0.9.0</span>
        </div>
        <div class="mb-3 flex gap-1 border-b border-[#313244]" role="tablist" aria-label="Installation platform">
          <button class="install-tab" type="button" role="tab" aria-selected="true" aria-controls="install-unix-panel" data-install-tab="unix">Linux / macOS</button>
          <button class="install-tab" type="button" role="tab" aria-selected="false" aria-controls="install-windows-panel" data-install-tab="windows">Windows</button>
        </div>
        <div id="install-unix-panel" role="tabpanel" data-install-panel="unix">
          <div class="flex min-w-0 items-start gap-3 rounded-lg border border-[#313244] bg-[#181825] p-3">
            <pre class="m-0 min-w-0 flex-1 overflow-x-auto font-mono text-[.68rem] leading-relaxed"><code id="install-unix" class="text-[#cdd6f4]">{installUnix}</code></pre>
            <button class="install-copy" type="button" data-copy-target="install-unix" data-default-label="Copy">Copy</button>
          </div>
        </div>
        <div id="install-windows-panel" role="tabpanel" data-install-panel="windows" hidden>
          <div class="flex min-w-0 items-start gap-3 rounded-lg border border-[#313244] bg-[#181825] p-3">
            <pre class="m-0 min-w-0 flex-1 overflow-x-auto font-mono text-[.68rem] leading-relaxed"><code id="install-windows" class="text-[#cdd6f4]">{installWindows}</code></pre>
            <button class="install-copy" type="button" data-copy-target="install-windows" data-default-label="Copy">Copy</button>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[.66rem]">
          <a class="text-[#a6e3a1]" href="https://github.com/shreyam1008/dbterm/releases/tag/v0.9.0">Binaries ↗</a>
          <a class="text-[#a6e3a1]" href={withBase("/guide/")}>Install guide →</a>
        </div>
      </aside>
      </div>

    </div>
  </section>

  <div class="site-container py-16 sm:py-20">
    <InteractiveDemo />
  </div>

  <section class="border-y border-[var(--line)] bg-[color-mix(in_srgb,var(--surface)_70%,transparent)] py-16 sm:py-20" id="product" aria-labelledby="product-title">
    <div class="site-container">
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 font-mono text-[.68rem] font-semibold tracking-[.14em] text-[var(--brand-strong)] uppercase">The whole system</p>
        <h2 id="product-title" class="text-[clamp(2.4rem,5vw,4.6rem)] leading-none tracking-[-.06em]">Four jobs. One binary.</h2>
        <p class="mt-5 max-w-2xl text-[var(--ink-soft)]">dbterm is no longer only a query client. Connections, data work, local operations, and recovery share the same saved context and keyboard model.</p>
      </header>
      <div class="grid overflow-hidden rounded-xl border border-[var(--line)] bg-[var(--surface)] lg:grid-cols-2">
        {productPillars.map((pillar) => (
          <article class="border-b border-[var(--line)] p-6 sm:p-8 lg:[&:nth-child(odd)]:border-r lg:[&:nth-last-child(-n+2)]:border-b-0">
            <span class="font-mono text-[.65rem] font-semibold text-[var(--brand-strong)]">{pillar.marker}</span>
            <h3 class="mt-8 text-2xl tracking-[-.045em]">{pillar.title}</h3>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--ink-soft)]">{pillar.body}</p>
            <ul class="mt-6 flex flex-wrap gap-2 p-0 font-mono text-[.64rem] text-[var(--ink-soft)]">
              {pillar.facts.map((fact) => <li class="list-none rounded-md border border-[var(--line)] bg-[var(--surface-raised)] px-2.5 py-1.5">{fact}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <a class="mt-7 inline-flex items-center gap-2 font-mono text-xs font-semibold text-[var(--brand-strong)]" href={withBase('/features/')}>See the complete feature map <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="border-y border-[var(--line)] bg-[#11111b] py-16 text-[#cdd6f4] sm:py-20" id="backup-center" aria-labelledby="backup-title">
    <div class="site-container grid items-center gap-10 lg:grid-cols-[minmax(0,.9fr)_minmax(420px,1.1fr)] lg:gap-16">
      <div>
        <p class="mb-3 font-mono text-[.68rem] font-semibold tracking-[.14em] text-[#a6e3a1] uppercase">Backup Center · Alt K</p>
        <h2 id="backup-title" class="max-w-[11ch] text-[clamp(2.5rem,5.5vw,4.8rem)] leading-[.95] tracking-[-.06em] text-white">Set the job. Close the terminal.</h2>
        <p class="mt-5 max-w-xl leading-relaxed text-[#a6adc8]">Schedule a local or remote database to a folder you control. dbterm stages, verifies, compresses, encrypts, records, and retains it.</p>
        <div class="mt-7 flex flex-wrap gap-2 font-mono text-[.66rem]">
          {['PostgreSQL', 'MySQL', 'SQLite', 'Turso', 'D1'].map((engine) => <span class="rounded-md border border-[#45475a] bg-[#181825] px-2.5 py-1.5 text-[#cdd6f4]">{engine}</span>)}
        </div>
        <a class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-[#a6e3a1]" href={withBase('/backup/')}>Explore Backup Center <span aria-hidden="true">→</span></a>
      </div>

      <div class="overflow-hidden rounded-2xl border border-[#45475a] bg-[#181825] shadow-2xl" aria-label="Backup workflow">
        <div class="flex items-center justify-between border-b border-[#313244] px-5 py-3 font-mono text-[.65rem]">
          <span class="text-[#a6e3a1]">prod-postgres · enabled</span><span class="text-[#6c7086]">next 02:00 IST</span>
        </div>
        <ol class="m-0 grid list-none p-0 sm:grid-cols-3">
          <li class="border-b border-[#313244] p-5 sm:border-r sm:border-b-0"><b class="font-mono text-[.62rem] text-[#89b4fa]">01 · SOURCE</b><p class="mt-3 mb-0 text-sm text-[#cdd6f4]">Remote PostgreSQL</p><small class="text-[#6c7086]">official pg_dump</small></li>
          <li class="border-b border-[#313244] p-5 sm:border-r sm:border-b-0"><b class="font-mono text-[.62rem] text-[#f9e2af]">02 · PIPELINE</b><p class="mt-3 mb-0 text-sm text-[#cdd6f4]">zstd level 3 + age</p><small class="text-[#6c7086]">one worker · X25519</small></li>
          <li class="p-5"><b class="font-mono text-[.62rem] text-[#a6e3a1]">03 · RESULT</b><p class="mt-3 mb-0 text-sm text-[#cdd6f4]">Verified artifact</p><small class="text-[#6c7086]">SHA-256 · count / age / size</small></li>
        </ol>
        <div class="border-t border-[#313244] p-5">
          <div class="mb-3 flex items-center justify-between gap-3 text-xs"><span class="text-[#a6adc8]">Native agent</span><span class="text-[#a6e3a1]">● running · 12 MiB · notifications ready</span></div>
          <pre class="m-0 overflow-x-auto rounded-lg bg-[#11111b] p-3 font-mono text-[.68rem] text-[#cdd6f4]"><code>dbterm backup service install
dbterm backup inspect --identity ./age-identity.txt prod_20260805.dump.zst.age
dbterm backup restore --connection prod --identity ./age-identity.txt --yes prod_20260805.dump.zst.age</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--line)] bg-[color-mix(in_srgb,var(--surface)_70%,transparent)] py-16 sm:py-20" id="features">
    <div class="site-container">
      <header class="mb-9 max-w-2xl">
        <p class="mb-3 font-mono text-[.68rem] font-semibold tracking-[.14em] text-[var(--brand-strong)] uppercase">The focused loop</p>
        <h2 class="text-[clamp(2.3rem,5vw,4.4rem)] leading-none tracking-[-.055em]">From table to answer.</h2>
      </header>

      <div class="grid overflow-hidden rounded-xl border border-[var(--line)] bg-[var(--surface)] md:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <article class="group min-h-[190px] border-b border-[var(--line)] p-5 transition hover:bg-[var(--brand-pale)] md:[&:nth-child(odd)]:border-r lg:border-r lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-last-child(-n+3)]:border-b-0">
            <div class="mb-8 flex items-center justify-between font-mono text-[.65rem]">
              <span class="text-[var(--ink-faint)]">{feature.index}</span>
              <span class="rounded-md border border-[var(--line)] bg-[var(--surface-raised)] px-2 py-1 font-semibold text-[var(--brand-strong)]">{feature.key}</span>
            </div>
            <h3 class="mb-2 text-lg tracking-[-.035em]">{feature.title}</h3>
            <p class="mb-0 text-sm leading-relaxed text-[var(--ink-soft)]">{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--line)] bg-[var(--brand-pale)] py-16 sm:py-20" aria-labelledby="engines-title">
    <div class="site-container grid gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="mb-3 font-mono text-[.68rem] font-semibold tracking-[.14em] text-[var(--brand-strong)] uppercase">Deliberate scope</p>
        <h2 id="engines-title" class="max-w-[11ch] text-[clamp(2.3rem,5vw,4.2rem)] leading-none tracking-[-.055em]">Five databases. One workflow.</h2>
        <div class="mt-8 flex flex-wrap gap-2">
          {engines.map(([name, mark]) => (
            <span class="inline-flex items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 py-2 text-sm"><b class="font-mono text-[.65rem] text-[var(--brand-strong)]">{mark}</b>{name}</span>
          ))}
        </div>
      </div>
      <div id="compare-title" class="lg:border-l lg:border-[var(--line)] lg:pl-12">
        <p class="mb-3 font-mono text-[.68rem] font-semibold tracking-[.14em] text-[var(--brand-strong)] uppercase">Choose honestly</p>
        <h2 class="text-[clamp(2rem,4vw,3.5rem)] leading-none tracking-[-.05em]">Focused—not universal.</h2>
        <p class="mt-5 max-w-xl text-[var(--ink-soft)]">Choose dbterm for a keyboard-first data loop. Choose a desktop workbench for diagrams, broad drivers, and GUI administration.</p>
        <a class="mt-5 inline-flex items-center gap-2 font-mono text-xs font-semibold text-[var(--brand-strong)]" href={withBase("/compare/")}>Compare dbterm, DBeaver, and terminal clients <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="site-container py-16 sm:py-20" id="install-again">
    <div class="flex flex-col gap-6 rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <p class="mb-1 font-mono text-[.65rem] font-semibold tracking-[.13em] text-[var(--brand-strong)] uppercase">Ready?</p>
        <h2 class="mb-0 text-[clamp(1.8rem,4vw,3rem)] tracking-[-.05em]">Install dbterm. Open—and protect—a database.</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class={primaryButton} href="#install">Copy the install command <span aria-hidden="true">↑</span></a>
        <a class={secondaryButton} href={withBase("/guide/")}>Read the guide</a>
      </div>
    </div>
  </section>

  <section class="site-container pb-8" id="faq">
    <div class="grid gap-8 border-t border-[var(--line)] pt-12 lg:grid-cols-[.55fr_1.45fr]">
      <header>
        <p class="mb-3 font-mono text-[.68rem] font-semibold tracking-[.14em] text-[var(--brand-strong)] uppercase">Quick answers</p>
        <h2 class="text-[clamp(2rem,4vw,3.2rem)] leading-none tracking-[-.055em]">Before you connect.</h2>
      </header>
      <div class="border-t border-[var(--line)]">
        {faqItems.map((item) => (
          <details class="group border-b border-[var(--line)] py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-[var(--ink)] marker:hidden">
              {item.question}
              <span class="grid size-7 shrink-0 place-items-center rounded-full border border-[var(--line)] font-mono text-sm transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mb-0 max-w-[760px] pt-3 pr-10 text-sm leading-relaxed text-[var(--ink-soft)]">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    const installTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-install-tab]"));
    const installPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-install-panel]"));
    installTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.installTab;
        installTabs.forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
        installPanels.forEach((panel) => { panel.hidden = panel.dataset.installPanel !== target; });
      });
    });
  </script>

  <style>
    .install-tab {
      border: 0;
      border-bottom: 2px solid transparent;
      background: transparent;
      padding: .65rem .75rem;
      color: #a6adc8;
      font: 600 .72rem/1 var(--font-mono);
      cursor: pointer;
    }

    .install-tab[aria-selected="true"] {
      border-bottom-color: #a6e3a1;
      color: #a6e3a1;
    }

    .install-copy {
      flex: none;
      border: 1px solid #45475a;
      border-radius: .4rem;
      background: #313244;
      padding: .45rem .65rem;
      color: #a6e3a1;
      font: 600 .65rem/1 var(--font-mono);
      cursor: pointer;
    }

    .install-copy:hover { background: #45475a; }
  </style>
</BaseLayout>
